<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexusGear Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gaming-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="container" style="padding-top:2rem;">
        <div class="admin-layout">
            <aside class="admin-sidebar glass-panel">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="brand" style="display:block; margin-bottom:1rem;">Admin</a>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
                <a asp-area="Admin" asp-controller="Brands" asp-action="Index">Brands</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
                <hr style="border-color:var(--border);" />
                <a asp-area="" asp-controller="Home" asp-action="Index">← Storefront</a>
            </aside>
            <main>@RenderBody()</main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
