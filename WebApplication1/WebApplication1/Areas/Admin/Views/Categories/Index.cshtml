@model IEnumerable<WebApplication1.Models.Category>
@{
    ViewData["Title"] = "Danh mục";
}

<h1>Danh mục <a asp-action="Create" class="btn btn-primary btn-sm">Thêm</a></h1>
<table class="admin-table glass-panel" style="padding:1rem; display:block;">
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.Id">Sửa</a>
                <form asp-action="Delete" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@c.Id" />
                    <button type="submit" class="btn btn-ghost btn-sm">Xóa</button>
                </form>
            </td>
        </tr>
    }
</table>
