@model WebApplication1.Models.Brand
@{ ViewData["Title"] = "Chỉnh sửa thương hiệu"; }
<h1>Chỉnh sửa thương hiệu</h1>
<form asp-action="Edit" method="post" class="glass-panel" style="padding:1rem;">
    <input type="hidden" asp-for="Id" />
    <input asp-for="Name" class="form-control" />
    <button type="submit" class="btn btn-primary" style="margin-top:0.75rem;">Lưu</button>
</form>
