@model WebApplication1.ViewModels.ProductFormViewModel

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data" class="glass-panel" style="padding:1.25rem;">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div style="margin-bottom:0.75rem;"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /></div>
    <div style="margin-bottom:0.75rem;"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div style="margin-bottom:0.75rem;"><label asp-for="Price"></label><input asp-for="Price" class="form-control" /></div>
    <div style="margin-bottom:0.75rem;"><label asp-for="Stock"></label><input asp-for="Stock" class="form-control" /></div>

    <div style="margin-bottom:0.75rem;">
        <label asp-for="CategoryId">Danh mục</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control"></select>
    </div>
    <div style="margin-bottom:0.75rem;">
        <label asp-for="BrandId">Thương hiệu</label>
        <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-control"></select>
    </div>

    <div style="margin-bottom:0.75rem;">
        <label asp-for="ImageFile">Tải ảnh lên thực tế</label>
        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />

        @if (Model.Id != 0 && !string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div style="margin-top:0.5rem; padding:0.5rem; border:1px solid #ddd; background-color: rgba(255,255,255,0.1); display:inline-block; border-radius:4px;">
                <span style="font-size:0.85rem; display:block; margin-bottom:0.25rem; color:#777;">Ảnh hiện tại:</span>
                <img src="@Model.ImageUrl" alt="Product Image" style="max-height: 100px; object-fit: contain; border-radius: 4px;" />
            </div>
        }
    </div>

    <div style="margin-bottom:0.75rem;">
        <label>Ảnh phụ sản phẩm</label>

        @if (Model.Id != 0 && Model.SecondaryImages.Count > 0)
        {
            <div style="margin-top:0.5rem; padding:0.75rem; border:1px solid #ddd; background-color: rgba(255,255,255,0.05); border-radius:4px;">
                <span style="font-size:0.85rem; display:block; margin-bottom:0.5rem; color:#aaa;">Quản lý ảnh phụ hiện tại (xóa hoặc thay thế từng ảnh):</span>
                @for (var i = 0; i < Model.SecondaryImages.Count; i++)
                {
                    <div style="display:flex; align-items:flex-start; gap:0.75rem; margin-bottom:0.75rem; padding:0.5rem; border:1px solid rgba(255,255,255,0.15); border-radius:4px; background:rgba(0,0,0,0.15);">
                        <input type="hidden" asp-for="SecondaryImages[i].Url" />
                        <img src="@Model.SecondaryImages[i].Url" alt="Ảnh phụ" style="max-height:80px; max-width:120px; object-fit:contain; border-radius:4px; border:1px solid rgba(255,255,255,0.2); padding:2px; flex-shrink:0;" />
                        <div style="flex:1; display:flex; flex-direction:column; gap:0.4rem;">
                            <label style="margin:0; font-size:0.9rem; cursor:pointer;">
                                <input asp-for="SecondaryImages[i].Remove" />
                                Xóa ảnh này
                            </label>
                            <div>
                                <label asp-for="SecondaryImages[i].ReplacementFile" style="font-size:0.85rem; color:#aaa;">Thay thế bằng ảnh mới:</label>
                                <input asp-for="SecondaryImages[i].ReplacementFile" type="file" class="form-control" accept="image/*" style="font-size:0.85rem; margin-top:0.25rem;" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div style="margin-top:0.75rem;">
            <label asp-for="SecondaryImageFiles">@(Model.Id == 0 ? "Tải ảnh phụ lên (chọn nhiều ảnh)" : "Thêm ảnh phụ mới (chọn nhiều ảnh)")</label>
            <input asp-for="SecondaryImageFiles" type="file" class="form-control" accept="image/*" multiple />
        </div>
    </div>

    <div style="margin-bottom:0.75rem;"><label><input asp-for="IsActive" /> Hiển thị</label></div>

    <h3>Thông số kỹ thuật</h3>
    @for (var i = 0; i < Model.Specifications.Count; i++)
    {
        <div style="display:flex; gap:0.5rem; margin-bottom:0.5rem;">
            <input asp-for="Specifications[i].Key" placeholder="Thuộc tính" class="form-control" />
            <input asp-for="Specifications[i].Value" placeholder="Giá trị" class="form-control" />
        </div>
    }

    <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
</form>