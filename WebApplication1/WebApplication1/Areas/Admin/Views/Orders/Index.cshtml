@model IEnumerable<WebApplication1.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng";
}

<h1>Đơn hàng</h1>
<div class="table-scroll glass-panel" style="padding:1rem;">
<table class="admin-table">
    <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Trạng thái</th><th>Tổng tiền</th><th></th></tr></thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o.Id</td>
                <td>@o.User.FullName</td>
                <td>@o.OrderDate.ToLocalTime().ToString("g")</td>
                <td>@o.Status</td>
                <td>@o.Total.ToString("N0") ₫</td>
                <td><a asp-action="Details" asp-route-id="@o.Id">Chi tiết</a></td>
            </tr>
        }
    </tbody>
</table>
</div>
