@model IEnumerable<WebApplication1.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-bottom: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <h1>Đơn hàng</h1>
        <span class="badge badge-info">@Model.Count() đơn</span>
    </div>

    <a asp-area="Admin" asp-controller="Orders" asp-action="ExportOrdersCsv" class="btn btn-ghost btn-sm" style="color: #10b981; border-color: rgba(16, 185, 129, 0.3); font-weight: 600;">
        📥 Xuất dữ liệu Excel/CSV
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="table-scroll glass-panel" style="padding:1rem;">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Thanh toán</th>
                <th>Trạng thái</th>
                <th>Tổng tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><strong>#@o.Id</strong></td>
                    <td>@o.User.FullName</td>
                    <td>@o.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge badge-muted" style="font-size:0.75rem;">@o.PaymentMethod</span></td>
                    <td><span class="status-badge status-@o.Status.ToString().ToLower()">@o.Status</span></td>
                    <td>@o.Total.ToString("N0") ₫</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-ghost btn-sm">Chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>