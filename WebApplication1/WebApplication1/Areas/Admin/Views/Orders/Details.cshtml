@model WebApplication1.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<h1>Order #@Model.Id</h1>
<p>@Model.User.FullName · @Model.Phone · @Model.ShippingAddress</p>
<p>Status: <strong>@Model.Status</strong> · Total: @Model.Total.ToString("N0") ₫</p>

<ul>
    @foreach (var item in Model.Items)
    {
        <li>@item.ProductName × @item.Quantity — @item.LineTotal.ToString("N0") ₫</li>
    }
</ul>

<form asp-action="UpdateStatus" method="post" class="glass-panel" style="padding:1rem; margin-top:1rem;">
    <input type="hidden" name="id" value="@Model.Id" />
    <label>Update status</label>
    <select name="status" class="form-control">
        @foreach (WebApplication1.Models.OrderStatus s in Enum.GetValues(typeof(WebApplication1.Models.OrderStatus)))
        {
            <option value="@s" selected="@(Model.Status == s)">@s</option>
        }
    </select>
    <button type="submit" class="btn btn-primary" style="margin-top:0.75rem;">Save</button>
</form>
