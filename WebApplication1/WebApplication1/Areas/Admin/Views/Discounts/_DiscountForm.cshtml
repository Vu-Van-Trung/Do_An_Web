@model WebApplication1.ViewModels.DiscountFormViewModel

<div class="glass-panel" style="padding:1.5rem;max-width:600px;">
    <div class="form-group">
        <label asp-for="Code" class="form-label">Mã giảm giá *</label>
        <input asp-for="Code" class="form-control" placeholder="VD: SALE20" style="text-transform:uppercase;" />
        <span asp-validation-for="Code" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Name" class="form-label">Tên chương trình *</label>
        <input asp-for="Name" class="form-control" placeholder="VD: Khuyến mãi hè 2025" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-group">
            <label asp-for="DiscountType" class="form-label">Loại giảm *</label>
            <select asp-for="DiscountType" class="form-control">
                <option value="0">Phần trăm (%)</option>
                <option value="1">Số tiền cố định (₫)</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Value" class="form-label">Giá trị giảm *</label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="Value" class="field-error"></span>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-group">
            <label asp-for="MinOrderAmount" class="form-label">Đơn tối thiểu (₫)</label>
            <input asp-for="MinOrderAmount" class="form-control" type="number" step="1000" min="0" />
        </div>
        <div class="form-group">
            <label asp-for="MaxUsage" class="form-label">Số lần dùng tối đa</label>
            <input asp-for="MaxUsage" class="form-control" type="number" min="1" placeholder="Không giới hạn" />
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-group">
            <label asp-for="StartDate" class="form-label">Ngày bắt đầu *</label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="EndDate" class="form-label">Ngày kết thúc *</label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="field-error"></span>
        </div>
    </div>

    <div class="form-group">
        <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
            <input asp-for="IsActive" type="checkbox" />
            <span>Kích hoạt ngay</span>
        </label>
    </div>

    <div style="display:flex;gap:0.75rem;margin-top:1rem;">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-ghost">Hủy</a>
    </div>
</div>
