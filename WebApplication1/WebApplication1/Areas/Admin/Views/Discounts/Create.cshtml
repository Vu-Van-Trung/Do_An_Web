@model WebApplication1.ViewModels.DiscountFormViewModel
@{
    ViewData["Title"] = "Tạo mã giảm giá";
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-ghost btn-sm">← Danh sách</a>
    <h1>Tạo mã giảm giá</h1>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_DiscountForm", Model)
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
