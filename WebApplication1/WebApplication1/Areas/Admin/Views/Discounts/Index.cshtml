@model IEnumerable<WebApplication1.Models.Discount>
@using WebApplication1.Models
@{
    ViewData["Title"] = "Quản lý khuyến mãi";
    var now = DateTime.Now;
    var filterType = ViewBag.FilterType as string;

    string PromoLabel(PromotionType t) => t switch
    {
        PromotionType.FlashSale => "⚡ Flash Sale",
        PromotionType.FreeShipping => "🚚 Free Ship",
        PromotionType.FirstOrder => "🎁 Đơn đầu",
        PromotionType.BuyXGetY => "🛒 Mua X tặng Y", // Cập nhật nhãn rõ nghĩa hơn
        _ => "🎟️ Coupon"
    };
    string PromoBadgeClass(PromotionType t) => t switch
    {
        PromotionType.FlashSale => "badge-warning",
        PromotionType.FreeShipping => "badge-info",
        PromotionType.FirstOrder => "badge-success",
        PromotionType.BuyXGetY => "badge-accent",
        _ => "badge-muted"
    };
}

<div class="page-header">
    <h1>Khuyến mãi</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Tạo khuyến mãi</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@* Filter tabs *@
<div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap;">
    <a asp-action="Index" class="btn btn-sm @(filterType == null ? "btn-primary" : "btn-ghost")">Tất cả (@Model.Count())</a>
    @foreach (var pt in Enum.GetValues<PromotionType>())
    {
        var count = Model.Count(d => d.PromotionType == pt);
        <a asp-action="Index" asp-route-type="@pt"
           class="btn btn-sm @(filterType == pt.ToString() ? "btn-primary" : "btn-ghost")">
            @PromoLabel(pt) (@count)
        </a>
    }
</div>

<div class="table-scroll glass-panel" style="padding:1rem;">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên chương trình</th>
                <th>Loại</th>
                <th>Phạm vi áp dụng</th>
                <th>Giá trị giảm</th>
                <th>Đơn tối thiểu</th>
                <th>Đã dùng</th>
                <th>Hiệu lực</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                var isExpired = d.EndDate < now;
                var isNotStarted = d.StartDate > now;
                <tr>
                    <td><strong style="font-family:monospace;letter-spacing:1px;">@d.Code</strong></td>
                    <td>
                        <div>@d.Name</div>
                        @if (!string.IsNullOrEmpty(d.Description))
                        {
                            <div style="font-size:0.78rem;color:var(--text-muted);">@d.Description</div>
                        }
                    </td>
                    <td><span class="badge @PromoBadgeClass(d.PromotionType)">@PromoLabel(d.PromotionType)</span></td>

                    <td>
                        @if (d.ApplicableCategoryId.HasValue)
                        {
                            <span class="badge badge-info" style="background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">Theo danh mục</span>
                        }
                        else
                        {
                            <span class="badge badge-muted" style="background-color: rgba(156, 163, 175, 0.1); color: #9ca3af;">Toàn cửa hàng</span>
                        }
                    </td>

                    <td>
                        @if (d.PromotionType == PromotionType.FreeShipping)
                        {
                            <span class="badge badge-info">Miễn phí ship</span>
                        }
                        @* BỔ SUNG: Tối ưu hiển thị cho hình thức BuyXGetY *@
                        else if (d.PromotionType == PromotionType.BuyXGetY)
                        {
                            <span>Mua @((int)d.Value) tặng 1 món</span>
                        }
                        else if (d.DiscountType == DiscountType.Percent)
                        {
                            <span>@($"{d.Value:N0}%")</span>
                            @if (d.MaxDiscountAmount.HasValue)
                            {
                                <span style="font-size:0.75rem;color:var(--text-muted);"> ≤@($"{d.MaxDiscountAmount:N0}₫")</span>
                            }
                        }
                        else
                        {
                            @($"{d.Value:N0} ₫")
                        }
                    </td>
                    <td>@(d.MinOrderAmount > 0 ? d.MinOrderAmount.ToString("N0") + " ₫" : "—")</td>
                    <td>@d.UsedCount @(d.MaxUsage.HasValue ? $"/ {d.MaxUsage}" : "")</td>
                    <td style="font-size:0.8rem;">
                        @d.StartDate.ToLocalTime().ToString("dd/MM/yy") — @d.EndDate.ToLocalTime().ToString("dd/MM/yy")
                    </td>
                    <td>
                        @if (!d.IsActive)
                        {
                            <span class="badge badge-muted">Tắt</span>
                        }
                        else if (isExpired)
                        {
                            <span class="badge badge-error">Hết hạn</span>
                        }
                        else if (isNotStarted)
                        {
                            <span class="badge badge-warning">Chưa bắt đầu</span>
                        }
                        else
                        {
                            <span class="badge badge-success">Đang chạy</span>
                        }
                    </td>
                    <td class="actions-cell">
                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-ghost btn-sm">Sửa</a>
                        <form asp-action="Toggle" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@d.Id" />
                            <button class="btn btn-ghost btn-sm">@(d.IsActive ? "Tắt" : "Bật")</button>
                        </form>
                        <form asp-action="Delete" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@d.Id" />
                            <button class="btn btn-ghost btn-sm" style="color:#ef4444;"
                                    onclick="return confirm('Xóa khuyến mãi này?')">
                                Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>