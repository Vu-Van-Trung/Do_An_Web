@model IEnumerable<WebApplication1.Models.Category>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<style>
    .cat-page { 
        padding: 2rem 0 4rem; 
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Premium Category Hero */
    .cat-hero {
        background: linear-gradient(135deg, #0f0a1e 0%, #1a0a2e 40%, #0a1628 100%);
        border-radius: 24px;
        padding: 3.5rem;
        margin-bottom: 3rem;
        border: 1px solid rgba(139, 92, 246, 0.15);
        position: relative;
        overflow: hidden;
        color: #e2e8f0;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }
    
    .cat-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .cat-hero h1 {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin: 0 0 0.75rem;
        color: #ffffff;
        letter-spacing: -0.5px;
    }
    .cat-hero h1 span { 
        background: linear-gradient(135deg, #8b5cf6, #3b82f6); 
        -webkit-background-clip: text; 
        -webkit-text-fill-color: transparent; 
        background-clip: text; 
    }
    .cat-hero p { 
        color: #94a3b8; 
        margin: 0; 
        font-size: 1.1rem; 
        max-width: 600px;
        line-height: 1.6;
    }

    .cat-groups { 
        display: flex; 
        flex-direction: column; 
        gap: 3.5rem; 
    }

    /* Category Group Panel */
    .cat-group {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--shadow);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .cat-group:hover {
        border-color: rgba(139, 92, 246, 0.3);
    }

    .cat-group-header {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1.5rem 2rem;
        background: var(--accent-light);
        border-bottom: 1px solid var(--border);
    }
    
    .cat-group-icon-wrapper {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        flex-shrink: 0;
    }
    
    .cat-group-icon {
        font-size: 1.8rem;
        color: #fff;
        line-height: 1;
    }
    
    .cat-group-header h2 {
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
        color: var(--text);
    }
    .cat-group-desc {
        color: var(--text-muted);
        font-size: 0.88rem;
        margin: 0.25rem 0 0 0;
    }

    /* Grid of Subcategories */
    .cat-sub-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.25rem;
        padding: 2rem;
        background: transparent;
    }

    /* Subcategory Cards */
    .cat-sub-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
        position: relative;
    }
    
    html[data-theme="light"] .cat-sub-card {
        background: rgba(0, 0, 0, 0.01);
    }
    
    .cat-sub-card::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), rgba(59, 130, 246, 0.05));
        opacity: 0;
        transition: opacity 0.35s ease;
    }

    .cat-sub-card:hover {
        transform: translateY(-5px);
        border-color: var(--accent);
        box-shadow: 0 10px 25px rgba(139, 92, 246, 0.12);
        background: rgba(255, 255, 255, 0.04);
    }
    
    html[data-theme="light"] .cat-sub-card:hover {
        background: rgba(255, 255, 255, 1);
    }
    
    .cat-sub-card:hover::before {
        opacity: 1;
    }

    .cat-sub-icon { 
        font-size: 2rem; 
        line-height: 1; 
        margin-bottom: 0.25rem; 
        transition: transform 0.3s ease;
        display: inline-block;
        z-index: 1;
    }
    
    .cat-sub-card:hover .cat-sub-icon {
        transform: scale(1.15) rotate(5deg);
    }
    
    .cat-sub-name {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text);
        transition: color 0.25s;
        z-index: 1;
    }
    .cat-sub-card:hover .cat-sub-name { 
        color: var(--accent); 
    }
    
    .cat-sub-desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.5;
        z-index: 1;
    }

    @@media (max-width: 768px) {
        .cat-hero { padding: 2rem; }
        .cat-sub-grid { 
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); 
            padding: 1.25rem;
            gap: 1rem;
        }
        .cat-group-header { padding: 1.25rem 1.5rem; }
    }
</style>

<div class="cat-page">
    <div class="cat-hero">
        <h1>Danh mục <span>sản phẩm</span></h1>
        <p>Khám phá toàn bộ thiết bị gaming và phụ kiện cho góc máy của bạn</p>
    </div>

    <div class="cat-groups">
        @foreach (var group in Model)
        {
            <section class="cat-group">
                <div class="cat-group-header">
                    <div class="cat-group-icon-wrapper">
                        <span class="cat-group-icon">@group.Icon</span>
                    </div>
                    <div>
                        <h2>@group.Name</h2>
                        @if (group.Description != null)
                        {
                            <p class="cat-group-desc">@group.Description</p>
                        }
                    </div>
                </div>
                @if (group.SubCategories.Any())
                {
                    <div class="cat-sub-grid">
                        @foreach (var sub in group.SubCategories)
                        {
                            @if (sub.Slug == "hot-deals")
                            {
                                <a asp-controller="Product" asp-action="Deals" class="cat-sub-card">
                                    <span class="cat-sub-icon">@sub.Icon</span>
                                    <span class="cat-sub-name">@sub.Name</span>
                                    <span class="cat-sub-desc">@sub.Description</span>
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Product" asp-action="Index"
                                   asp-route-categoryId="@sub.Id" class="cat-sub-card">
                                    <span class="cat-sub-icon">@sub.Icon</span>
                                    <span class="cat-sub-name">@sub.Name</span>
                                    <span class="cat-sub-desc">@sub.Description</span>
                                </a>
                            }
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>
