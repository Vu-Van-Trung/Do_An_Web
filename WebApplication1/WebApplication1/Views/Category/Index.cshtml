@model IEnumerable<WebApplication1.Models.Category>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<style>
    .cat-page { padding: 1.5rem 0 3rem; }

    .cat-hero {
        background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
        border-radius: 20px;
        padding: 2.5rem 3rem;
        margin-bottom: 2.5rem;
        border: 1px solid #e0e7ff;
    }
    .cat-hero h1 {
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 800;
        margin: 0 0 0.5rem;
        color: var(--text);
    }
    .cat-hero h1 span { color: var(--accent); }
    .cat-hero p { color: var(--text-muted); margin: 0; font-size: 1rem; }

    .cat-groups { display: flex; flex-direction: column; gap: 2.5rem; }

    .cat-group {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .cat-group-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        background: var(--accent-light);
        border-bottom: 1px solid #e0e7ff;
    }
    .cat-group-icon {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
    }
    .cat-group-header h2 {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 0.2rem;
        color: var(--text);
    }
    .cat-group-desc {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin: 0;
    }

    .cat-sub-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1px;
        background: var(--border);
    }

    .cat-sub-card {
        background: #fff;
        padding: 1.25rem 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        text-decoration: none;
        color: inherit;
        transition: background 0.15s, transform 0.15s;
    }
    .cat-sub-card:hover {
        background: var(--accent-light);
        transform: none;
    }
    .cat-sub-card:hover .cat-sub-name { color: var(--accent); }

    .cat-sub-icon { font-size: 1.75rem; line-height: 1; margin-bottom: 0.15rem; }
    .cat-sub-name {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text);
        transition: color 0.15s;
    }
    .cat-sub-desc {
        font-size: 0.78rem;
        color: var(--text-muted);
        line-height: 1.45;
    }

    @@media (max-width: 600px) {
        .cat-hero { padding: 1.5rem; }
        .cat-sub-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
        .cat-group-header { padding: 1rem 1.25rem; }
    }
</style>

<div class="cat-page">
    <div class="cat-hero">
        <h1>Danh mục <span>sản phẩm</span></h1>
        <p>Khám phá toàn bộ thiết bị gaming và phụ kiện cho góc máy của bạn</p>
    </div>

    <div class="cat-groups">
        @foreach (var group in Model)
        {
            <section class="cat-group">
                <div class="cat-group-header">
                    <span class="cat-group-icon">@group.Icon</span>
                    <div>
                        <h2>@group.Name</h2>
                        @if (group.Description != null)
                        {
                            <p class="cat-group-desc">@group.Description</p>
                        }
                    </div>
                </div>
                @if (group.SubCategories.Any())
                {
                    <div class="cat-sub-grid">
                        @foreach (var sub in group.SubCategories)
                        {
                            @if (sub.Slug == "hot-deals")
                            {
                                <a asp-controller="Product" asp-action="Deals" class="cat-sub-card">
                                    <span class="cat-sub-icon">@sub.Icon</span>
                                    <span class="cat-sub-name">@sub.Name</span>
                                    <span class="cat-sub-desc">@sub.Description</span>
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Product" asp-action="Index"
                                   asp-route-categoryId="@sub.Id" class="cat-sub-card">
                                    <span class="cat-sub-icon">@sub.Icon</span>
                                    <span class="cat-sub-name">@sub.Name</span>
                                    <span class="cat-sub-desc">@sub.Description</span>
                                </a>
                            }
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>
