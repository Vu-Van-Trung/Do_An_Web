@model WebApplication1.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Cửa hàng";
    var f = Model.Filter;
}

@using WebApplication1.Models
@functions {
    public (decimal bestPrice, Discount? bestVoucher) GetBestPrice(Product p, IEnumerable<Discount>? discounts)
    {
        if (discounts == null) return (p.Price, null);
        decimal bestPrice = p.Price;
        Discount? bestVoucher = null;
        decimal maxDiscount = 0;

        foreach (var d in discounts)
        {
            if (!d.IsActive || d.StartDate > DateTime.UtcNow || d.EndDate < DateTime.UtcNow) continue;
            if (d.ApplicableCategoryId.HasValue && d.ApplicableCategoryId.Value != p.CategoryId) continue;
            if (d.MinOrderAmount > p.Price) continue;
            if (d.PromotionType == PromotionType.FreeShipping) continue;

            decimal discountAmount = 0;
            if (d.DiscountType == DiscountType.Percent)
            {
                discountAmount = Math.Round(p.Price * d.Value / 100, 0);
                if (d.MaxDiscountAmount.HasValue)
                {
                    discountAmount = Math.Min(discountAmount, d.MaxDiscountAmount.Value);
                }
            }
            else
            {
                discountAmount = d.Value;
            }

            if (discountAmount > maxDiscount)
            {
                maxDiscount = discountAmount;
                bestVoucher = d;
            }
        }

        return (p.Price - maxDiscount, bestVoucher);
    }
}

<section class="filters glass-panel">
    <form method="get" asp-action="Index">
        <div>
            <label>Tìm kiếm</label>
            <input type="text" name="Search" value="@f.Search" placeholder="DeathAdder, bàn phím..." />
        </div>
        <div>
            <label>Danh mục</label>
            <select name="CategoryId">
                <option value="">Tất cả</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(f.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Thương hiệu</label>
            <select name="BrandId">
                <option value="">Tất cả</option>
                @foreach (var b in Model.Brands)
                {
                    <option value="@b.Id" selected="@(f.BrandId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Kết nối</label>
            <select name="Connection">
                <option value="">Tất cả</option>
                @foreach (var v in Model.Connections)
                {
                    <option value="@v" selected="@(f.Connection == v)">@v</option>
                }
            </select>
        </div>
        <div>
            <label>Loại Switch</label>
            <select name="SwitchType">
                <option value="">Tất cả</option>
                @foreach (var v in Model.SwitchTypes)
                {
                    <option value="@v" selected="@(f.SwitchType == v)">@v</option>
                }
            </select>
        </div>
        <div>
            <label>DPI</label>
            <select name="Dpi">
                <option value="">Tất cả</option>
                @foreach (var v in Model.DpiOptions)
                {
                    <option value="@v" selected="@(f.Dpi == v)">@v</option>
                }
            </select>
        </div>
        <div>
            <label>Giá từ</label>
            <input type="number" name="MinPrice" value="@f.MinPrice" />
        </div>
        <div>
            <label>Giá đến</label>
            <input type="number" name="MaxPrice" value="@f.MaxPrice" />
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Lọc</button>
        </div>
    </form>
</section>

<div class="product-grid">
    @foreach (var product in Model.Products.Items)
    {
        var brandSlug = product.Brand.Name.ToLower().Replace(" ", "");
        var (bestPrice, bestVoucher) = GetBestPrice(product, ViewBag.ActiveDiscounts as IEnumerable<Discount>);
        <article class="product-card" data-category="@product.Category.Name">
            <!-- Nút So sánh nhanh -->
            <div class="card-actions-overlay">
                <form asp-controller="Comparison" asp-action="Add" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit" class="card-action-btn" title="So sánh">
                        <i class="bi bi-arrow-left-right"></i>
                    </button>
                </form>
            </div>
            <a asp-action="Details" asp-route-id="@product.Id">
                <span class="product-card-brand-chip brand-chip-@brandSlug">@product.Brand.Name</span>
                <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                <div class="body">
                    <h3>@product.Name</h3>
                    <p class="meta">@product.Brand.Name &middot; @product.Category.Name</p>
                </div>
            </a>
            <div class="card-footer" style="flex-direction: column; align-items: flex-start; gap: 0.25rem;">
                @if (bestVoucher != null)
                {
                    var percent = (int)Math.Round((product.Price - bestPrice) * 100 / product.Price);
                    <div style="display: flex; flex-direction: column; gap: 0.15rem; width: 100%;">
                        <span class="price-new">@bestPrice.ToString("N0") ₫</span>
                        <div style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; line-height: 1;">
                            <span class="price-old" style="margin-right: 0;">@product.Price.ToString("N0") ₫</span>
                            <span class="discount-percent" style="color: var(--text-muted); font-weight: 500;">-@percent%</span>
                        </div>
                    </div>
                }
                else
                {
                    <span class="price">@product.Price.ToString("N0") ₫</span>
                }
            </div>
            <div class="card-cart-overlay">
                <form asp-controller="Cart" asp-action="Add" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn-cart" title="Thêm vào giỏ">
                        <i class="bi bi-cart-plus-fill"></i> Thêm vào giỏ
                    </button>
                </form>
            </div>
        </article>
    }
</div>

@if (!Model.Products.Items.Any())
{
    <p class="meta">Không có sản phẩm nào phù hợp với bộ lọc.</p>
}

<nav class="pagination">
    @for (var p = 1; p <= Model.Products.TotalPages; p++)
    {
        if (p == Model.Products.Page)
        {
            <span class="active">@p</span>
        }
        else
        {
            <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> {
                ["Search"] = f.Search, ["CategoryId"] = f.CategoryId?.ToString(), ["BrandId"] = f.BrandId?.ToString(),
                ["Connection"] = f.Connection, ["SwitchType"] = f.SwitchType, ["Dpi"] = f.Dpi,
                ["MinPrice"] = f.MinPrice?.ToString(), ["MaxPrice"] = f.MaxPrice?.ToString(), ["Page"] = p.ToString()
            })">@p</a>
        }
    }
</nav>
