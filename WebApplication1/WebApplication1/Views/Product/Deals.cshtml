@model IEnumerable<WebApplication1.Models.Discount>
@using WebApplication1.Models
@{
    ViewData["Title"] = "Voucher & Thẻ giảm giá";
    var flashSales   = ViewBag.FlashSales   as List<Discount> ?? new();
    var freeShipping = ViewBag.FreeShipping as List<Discount> ?? new();
    var firstOrders  = ViewBag.FirstOrders  as List<Discount> ?? new();
    var coupons      = ViewBag.Coupons      as List<Discount> ?? new();
    var now          = DateTime.UtcNow;
}

<style>
    /* ── VOUCHER PAGE ── */
    .deals-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4c1d95 100%);
        border-radius: 20px;
        padding: 3rem 2.5rem;
        margin: 1.5rem 0 2.5rem;
        color: #fff;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .deals-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Ccircle cx='30' cy='30' r='28'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.4;
    }
    .deals-hero-content { position: relative; z-index: 1; }
    .deals-hero h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); margin: 0 0 0.5rem; font-weight: 800; }
    .deals-hero p { opacity: 0.85; margin: 0; font-size: 1rem; }

    .deals-section { margin-bottom: 2.5rem; }
    .deals-section-title {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1rem;
        font-family: var(--font-display);
        color: var(--text);
    }
    .deals-section-title .emoji { font-size: 1.4rem; }

    .deals-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.25rem;
    }

    /* ── TICKET DESIGN ── */
    .deal-card {
        background: #fff;
        border: 2px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: var(--shadow-sm);
        display: flex;
        min-height: 140px;
    }
    .deal-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

    /* Left panel representing the ticket stub */
    .deal-left {
        width: 100px;
        background: var(--accent-light);
        color: var(--accent);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-weight: 800;
        border-right: 2px dashed var(--border);
        position: relative;
        padding: 0.5rem;
        text-align: center;
    }
    /* Ticket notch details */
    .deal-left::before, .deal-left::after {
        content: '';
        position: absolute;
        right: -8px;
        width: 16px;
        height: 16px;
        background: var(--bg);
        border-radius: 50%;
        border: 2px solid var(--border);
        z-index: 5;
    }
    .deal-left::before { top: -8px; }
    .deal-left::after { bottom: -8px; }

    .deal-left-val { font-size: 1.5rem; line-height: 1.1; }
    .deal-left-unit { font-size: 0.75rem; text-transform: uppercase; margin-top: 0.2rem; }

    /* Right panel representing ticket info */
    .deal-right {
        flex: 1;
        padding: 1.1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .deal-name { font-weight: 700; margin: 0 0 0.25rem; font-size: 0.95rem; color: var(--text); }
    .deal-desc { font-size: 0.83rem; color: var(--text-muted); margin: 0 0 0.75rem; }
    .deal-meta { font-size: 0.78rem; color: var(--text-muted); }

    .deal-code-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }
    .deal-code {
        flex: 1;
        background: #f5f3ff;
        border: 1.5px dashed #8b5cf6;
        border-radius: 8px;
        padding: 0.35rem 0.5rem;
        font-family: monospace;
        font-size: 0.92rem;
        font-weight: 700;
        color: #5b21b6;
        letter-spacing: 1px;
        text-align: center;
    }
    .deal-copy-btn {
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        border: none;
        background: var(--accent);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
    }
    .deal-copy-btn:hover { background: var(--accent-dark); }
    .deal-copy-btn.copied { background: #16a34a; }

    /* ── SPECIAL THEME STYLES ── */
    /* Yellow Voucher */
    .deal-card-yellow {
        border-color: #f59e0b;
    }
    .deal-card-yellow .deal-left {
        background: #fffbeb;
        color: #d97706;
        border-right-color: #f59e0b;
    }
    .deal-card-yellow .deal-left::before, .deal-card-yellow .deal-left::after {
        border-color: #f59e0b;
    }
    .deal-card-yellow .deal-code {
        background: #fffbeb;
        border-color: #f59e0b;
        color: #b45309;
    }
    .deal-card-yellow .deal-copy-btn {
        background: #d97706;
    }
    .deal-card-yellow .deal-copy-btn:hover {
        background: #b45309;
    }

    /* Green Voucher */
    .deal-card-green {
        border-color: #10b981;
    }
    .deal-card-green .deal-left {
        background: #f0fdf4;
        color: #059669;
        border-right-color: #10b981;
    }
    .deal-card-green .deal-left::before, .deal-card-green .deal-left::after {
        border-color: #10b981;
    }
    .deal-card-green .deal-code {
        background: #f0fdf4;
        border-color: #10b981;
        color: #047857;
    }
    .deal-card-green .deal-copy-btn {
        background: #059669;
    }
    .deal-card-green .deal-copy-btn:hover {
        background: #047857;
    }

    /* ── REGISTER BANNER ── */
    .register-banner {
        background: linear-gradient(90deg, #f59e0b 0%, #d97706 50%, #10b981 100%);
        border-radius: 16px;
        padding: 1.75rem 2rem;
        margin-bottom: 2.5rem;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
        box-shadow: 0 4px 18px rgba(217, 119, 6, 0.25);
    }
    .register-banner-text h3 { margin: 0 0 0.35rem; font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; }
    .register-banner-text p { margin: 0; font-size: 0.9rem; opacity: 0.95; }
    .register-banner .btn {
        background: #fff;
        color: #d97706;
        border: none;
    }
    .register-banner .btn:hover {
        background: #fef3c7;
        color: #b45309;
        transform: translateY(-2px);
    }
</style>

<div class="deals-hero">
    <div class="deals-hero-content">
        <h1>🎫 Voucher &amp; Thẻ giảm giá</h1>
        <p>Chọn các mã giảm giá tốt nhất để áp dụng cho đơn hàng của bạn</p>
    </div>
</div>

@* ── GUEST BANNER ── *@
@if (User.Identity?.IsAuthenticated != true)
{
    <div class="register-banner">
        <div class="register-banner-text">
            <h3>🎁 Quà tặng cho Thành viên mới!</h3>
            <p>Đăng ký tài khoản ngay để nhận bộ đôi Voucher: Giảm 200k (đơn từ 500k) và Free Ship 0đ.</p>
        </div>
        <a asp-controller="Account" asp-action="Register" class="btn">Đăng ký ngay</a>
    </div>
}

@* ── MY VOUCHERS (New user gifts) ── *@
@if (ViewBag.IsNewUser == true)
{
    <div class="deals-section">
        <div class="deals-section-title">
            <span class="emoji">🎁</span> Voucher của bạn (Quà tặng thành viên mới)
        </div>
        <div class="deals-grid">
            @* 200k Yellow Voucher *@
            <div class="deal-card deal-card-yellow">
                <div class="deal-left">
                    <div class="deal-left-val">200K</div>
                    <div class="deal-left-unit">Giảm</div>
                </div>
                <div class="deal-right">
                    <div>
                        <div class="deal-name">Quà tặng Đăng ký mới 200k</div>
                        <div class="deal-desc">Giảm ngay 200.000đ cho đơn hàng từ 500.000đ trở lên.</div>
                    </div>
                    <div class="deal-meta">
                        <span>Hạn dùng: Hạn dài</span>
                    </div>
                    <div class="deal-code-row" style="display:flex; align-items:center; gap:0.5rem; justify-content:space-between; width:100%;">
                        <div class="deal-code" style="margin:0;">NEWUSER200K</div>
                        <div style="display:flex; gap:0.35rem; align-items:center;">
                            <span style="font-size:0.8rem; color:#d97706; font-weight:600; background:#fffbeb; border:1px solid #fde68a; padding:0.25rem 0.5rem; border-radius:6px; white-space:nowrap;">Đã lưu</span>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm" style="background:#d97706; color:#fff; border:none; padding:0.25rem 0.6rem; border-radius:6px; font-size:0.8rem; height:auto; line-height:1; min-height:0;">Dùng ngay</a>
                        </div>
                    </div>
                </div>
            </div>

            @* Free ship Green Voucher *@
            <div class="deal-card deal-card-green">
                <div class="deal-left">
                    <div class="deal-left-val">FREE</div>
                    <div class="deal-left-unit">Ship 0đ</div>
                </div>
                <div class="deal-right">
                    <div>
                        <div class="deal-name">Miễn phí vận chuyển 0đ</div>
                        <div class="deal-desc">Miễn phí vận chuyển toàn quốc dành riêng cho tài khoản mới.</div>
                    </div>
                    <div class="deal-meta">
                        <span>Hạn dùng: Hạn dài</span>
                    </div>
                    <div class="deal-code-row" style="display:flex; align-items:center; gap:0.5rem; justify-content:space-between; width:100%;">
                        <div class="deal-code" style="margin:0;">NEWUSERFREE</div>
                        <div style="display:flex; gap:0.35rem; align-items:center;">
                            <span style="font-size:0.8rem; color:#059669; font-weight:600; background:#f0fdf4; border:1px solid #a7f3d0; padding:0.25rem 0.5rem; border-radius:6px; white-space:nowrap;">Đã lưu</span>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm" style="background:#059669; color:#fff; border:none; padding:0.25rem 0.6rem; border-radius:6px; font-size:0.8rem; height:auto; line-height:1; min-height:0;">Dùng ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ── ALL ACTIVE DEALS ── *@
<div class="deals-section">
    <div class="deals-section-title">
        <span class="emoji">🎟️</span> Vouchers &amp; Khuyến mãi hiện có
    </div>
    
    @if (!Model.Any(d => d.Code != "NEWUSER200K" && d.Code != "NEWUSERFREE"))
    {
        <p class="meta" style="text-align:center; padding:2rem 0;">Tạm thời chưa có thêm voucher chung nào khác.</p>
    }
    else
    {
        <div class="deals-grid">
            @foreach (var d in Model.Where(d => d.Code != "NEWUSER200K" && d.Code != "NEWUSERFREE"))
            {
                var cardClass = "";
                var leftVal = d.DiscountType == DiscountType.Percent ? $"{d.Value:N0}%" : $"{d.Value / 1000:N0}K";
                var leftUnit = d.DiscountType == DiscountType.Percent ? "OFF" : "Giảm";

                if (d.PromotionType == PromotionType.FreeShipping)
                {
                    cardClass = "deal-card-green";
                    leftVal = "FREE";
                    leftUnit = "Ship";
                }
                else if (d.PromotionType == PromotionType.FirstOrder)
                {
                    cardClass = "deal-card-yellow";
                }

                <div class="deal-card @cardClass">
                    <div class="deal-left">
                        <div class="deal-left-val">@leftVal</div>
                        <div class="deal-left-unit">@leftUnit</div>
                    </div>
                    <div class="deal-right">
                        <div>
                            <div class="deal-name">@d.Name</div>
                            @if (!string.IsNullOrEmpty(d.Description))
                            {
                                <div class="deal-desc">@d.Description</div>
                            }
                        </div>
                        <div class="deal-meta">
                            @if (d.MinOrderAmount > 0) { <span>Đơn từ @($"{d.MinOrderAmount:N0}")₫ &middot; </span> }
                            <span>HSD: @d.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="deal-code-row">
                            <div class="deal-code">@d.Code</div>
                            <button class="deal-copy-btn" onclick="copyCode(this, '@d.Code')">Lưu mã</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div style="text-align:center;margin-top:2rem;">
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
        🛒 Mua ngay với Voucher tốt nhất
    </a>
</div>

<script>
function copyCode(btn, code) {
    navigator.clipboard.writeText(code).then(function () {
        var orig = btn.textContent;
        btn.textContent = '✓ Đã lưu!';
        btn.classList.add('copied');
        setTimeout(function () {
            btn.textContent = orig;
            btn.classList.remove('copied');
        }, 2000);
    });
}
</script>
