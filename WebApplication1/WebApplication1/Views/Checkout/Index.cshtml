@model WebApplication1.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";

    // Lấy thông tin mã giảm giá và số tiền từ Session hoặc TempData do Controller đẩy sang (nếu có)
    var sessionDiscountCode = Context.Session.GetString("AppliedCouponCode") ?? "";
    var sessionDiscountAmountStr = Context.Session.GetString("DiscountAmount") ?? "0";
    decimal serverDiscountAmount = 0;
    decimal.TryParse(sessionDiscountAmountStr, out serverDiscountAmount);
}

<style>
    .checkout-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 1.5rem;
        align-items: start;
    }

    .checkout-step-bar {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 1.75rem;
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
    }

        .step-item.active {
            color: var(--accent);
        }

        .step-item.done {
            color: #16a34a;
        }

    .step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
        background: #f3f4f6;
        color: var(--text-muted);
        border: 2px solid #e5e7eb;
    }

    .step-item.active .step-num {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }

    .step-item.done .step-num {
        background: #16a34a;
        color: #fff;
        border-color: #16a34a;
    }

    .step-divider {
        flex: 1;
        height: 2px;
        background: #e5e7eb;
        margin: 0 12px;
        max-width: 60px;
    }

        .step-divider.done {
            background: #16a34a;
        }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.35rem;
            color: var(--text);
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.9rem;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: 0.9rem;
        font-family: inherit;
        outline: none;
        transition: border-color .15s;
        background: #fff;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: var(--accent);
        }

    /* ── Payment options ── */
    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .payment-option {
        display: none;
    }

    .payment-label {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 1rem 1.25rem;
        border: 2px solid var(--border);
        border-radius: 12px;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }

    .payment-option:checked + .payment-label {
        border-color: var(--accent);
        background: var(--accent-light);
    }

    .payment-icon {
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .payment-info strong {
        display: block;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .payment-info span {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .vnpay-badge {
        margin-left: auto;
        background: #e8253a;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        letter-spacing: 0.3px;
    }

    /* ── Order summary ── */
    .summary-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.875rem;
        padding: 0.35rem 0;
    }

        .summary-item.total {
            font-weight: 700;
            font-size: 1rem;
            border-top: 1px solid var(--border);
            margin-top: 0.5rem;
            padding-top: 0.75rem;
        }

            .summary-item.total .price {
                color: var(--accent);
            }

    .summary-product {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-size: 0.875rem;
    }

        .summary-product + .summary-product {
            border-top: 1px dashed #f3f4f6;
        }

    @@media (max-width: 720px) {
        .checkout-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div style="padding-top:1.5rem; padding-bottom:3rem;">

    <div class="checkout-step-bar">
        <div class="step-item @(Model.Step >= 1 ? (Model.Step > 1 ? "done" : "active") : "")">
            <div class="step-num">@(Model.Step > 1 ? "✓" : "1")</div>
            <span>Giao hàng</span>
        </div>
        <div class="step-divider @(Model.Step > 1 ? "done" : "")"></div>
        <div class="step-item @(Model.Step == 2 ? "active" : "")">
            <div class="step-num">2</div>
            <span>Thanh toán</span>
        </div>
    </div>

    <div class="checkout-layout">

        <div class="glass-panel" style="padding:1.5rem;">

            @if (Model.Step == 1)
            {
                <h2 style="margin:0 0 1.25rem; font-size:1.2rem;">Thông tin giao hàng</h2>
                <form asp-action="Shipping" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger" style="margin-bottom:.75rem;"></div>

                    <div class="form-group">
                        <label asp-for="Shipping.FullName">Họ và tên *</label>
                        <input asp-for="Shipping.FullName" class="form-control" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="Shipping.FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Shipping.Phone">Số điện thoại *</label>
                        <input asp-for="Shipping.Phone" class="form-control" placeholder="0912 345 678" />
                        <span asp-validation-for="Shipping.Phone" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Địa chỉ nhận hàng *</label>
                        @if (!string.IsNullOrEmpty(Model.Shipping.ShippingAddress))
                        {
                            <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:0.75rem;">
                                <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal; cursor:pointer;">
                                    <input type="radio" name="AddressType" value="default" id="addressTypeDefault" checked />
                                    <span>Sử dụng địa chỉ mặc định: <strong>@Model.Shipping.ShippingAddress</strong></span>
                                </label>
                                <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal; cursor:pointer;">
                                    <input type="radio" name="AddressType" value="new" id="addressTypeNew" />
                                    <span>Giao đến địa chỉ mới</span>
                                </label>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="AddressType" value="new" id="addressTypeNew" />
                        }

                        <div id="defaultAddressWrapper" style="display: @(string.IsNullOrEmpty(Model.Shipping.ShippingAddress) ? "none" : "block"); margin-bottom: 0.5rem;">
                            <input type="hidden" id="defaultAddressValue" value="@Model.Shipping.ShippingAddress" />
                        </div>

                        <div id="newAddressWrapper" style="display: @(string.IsNullOrEmpty(Model.Shipping.ShippingAddress) ? "block" : "none"); border: 1px solid var(--border); padding: 1rem; border-radius: 10px; background: rgba(0,0,0,0.01); margin-bottom: 0.75rem;">
                            <div style="display:grid; grid-template-columns:1fr; gap:0.75rem;">
                                <div>
                                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Tỉnh / Thành phố *</label>
                                    <select id="provinceSelect" class="form-control">
                                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Phường / Xã *</label>
                                    <select id="wardSelect" class="form-control" disabled>
                                        <option value="">-- Chọn Phường/Xã --</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Số nhà, tên đường (Địa chỉ cụ thể) *</label>
                                    <input type="text" id="specificAddress" class="form-control" placeholder="Số nhà, tên đường..." />
                                </div>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Shipping.ShippingAddress" id="shippingAddressCombined" />
                        <input type="hidden" asp-for="Shipping.ProvinceCode"    id="provinceCodeInput" />
                        <input type="hidden" asp-for="Shipping.SelectedService" id="selectedServiceInput" value="Nhanh" />
                        <span asp-validation-for="Shipping.ShippingAddress" class="text-danger"></span>
                    </div>

                    <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const defaultRadio = document.getElementById("addressTypeDefault");
                        const newRadio = document.getElementById("addressTypeNew");
                        const newAddressWrapper = document.getElementById("newAddressWrapper");
                        const provinceSelect = document.getElementById("provinceSelect");
                        const wardSelect = document.getElementById("wardSelect");
                        const specificAddressInput = document.getElementById("specificAddress");
                        const shippingAddressCombined = document.getElementById("shippingAddressCombined");
                        const form = shippingAddressCombined.closest("form");

                        function toggleAddressFields() {
                            const isNew = (newRadio && newRadio.checked) || !defaultRadio;
                            if (isNew) {
                                newAddressWrapper.style.display = "block";
                                provinceSelect.required = true;
                                wardSelect.required = true;
                                specificAddressInput.required = true;
                            } else {
                                newAddressWrapper.style.display = "none";
                                provinceSelect.required = false;
                                wardSelect.required = false;
                                specificAddressInput.required = false;
                            }
                        }

                        if (defaultRadio && newRadio) {
                            defaultRadio.addEventListener("change", toggleAddressFields);
                            newRadio.addEventListener("change", toggleAddressFields);
                        }

                        toggleAddressFields();

                        const provinceCodeInput   = document.getElementById("provinceCodeInput");
                        const selectedServiceInput = document.getElementById("selectedServiceInput");

                        // ── Bảng giá (mirror ShippingCalculator.BaseRates) ──────────────────
                        const HCM_CODES   = new Set([79]);
                        const NAM_CODES   = new Set([75,80,82,86,91,92,96]);
                        const TRUNG_CODES = new Set([38,40,42,44,46,48,51,52,56,66,68]);
                        const RATES = [
                            { label:"Nội thành HCM",  r:{ TietKiem:[25000,"2–3 ngày"],    Nhanh:[35000,"Hôm nay – ngày mai"], HoaToc:[60000,"2–4 giờ"] } },
                            { label:"Miền Nam",        r:{ TietKiem:[35000,"3–5 ngày"],    Nhanh:[50000,"1–2 ngày"],           HoaToc:[90000,"Trong ngày"] } },
                            { label:"Miền Trung",      r:{ TietKiem:[50000,"4–6 ngày"],    Nhanh:[70000,"2–3 ngày"],           HoaToc:[120000,"1–2 ngày"] } },
                            { label:"Miền Bắc",        r:{ TietKiem:[70000,"5–7 ngày"],    Nhanh:[95000,"2–4 ngày"],           HoaToc:[150000,"2–3 ngày"] } },
                        ];
                        const MULTIPLIERS = [1.0, 1.5, 3.0];
                        const cartClassIdx = @(ViewBag.CartShippingClassIndex ?? 0);
                        const multiplier   = MULTIPLIERS[cartClassIdx];
                        const isCongKenh   = cartClassIdx === 2;

                        function getRegionIdx(code) {
                            if (HCM_CODES.has(code))   return 0;
                            if (NAM_CODES.has(code))   return 1;
                            if (TRUNG_CODES.has(code)) return 2;
                            return 3;
                        }

                        function renderShippingOptions(code) {
                            const box = document.getElementById("shippingOptionsBox");
                            const list = document.getElementById("shippingOptionsList");
                            if (!code) { box.style.display = "none"; return; }

                            const regionIdx = getRegionIdx(code);
                            const isHCM     = regionIdx === 0;
                            const rates     = RATES[regionIdx].r;
                            const services  = ["TietKiem","Nhanh","HoaToc"];
                            const labels    = { TietKiem:"Tiết kiệm", Nhanh:"Nhanh", HoaToc:"Hỏa tốc" };
                            list.innerHTML  = "";

                            let initialFeeData = null; // data of the currently selected service

                            services.forEach(svc => {
                                if (isCongKenh && svc === "HoaToc") return;
                                const [base, eta] = rates[svc];
                                const isSelected  = (selectedServiceInput.value || "Nhanh") === svc;

                                // ── Tính phí ──
                                let feeText, subText;
                                let baseFeeNum = 0, surchargeNum = 0;
                                let isContactOnly = false, isFreeShip = false;

                                if (isCongKenh && !isHCM) {
                                    feeText = "Liên hệ báo phí";
                                    subText = eta;
                                    isContactOnly = true;
                                } else if (isCongKenh && isHCM) {
                                    feeText = "Miễn phí";
                                    subText = eta + " (shop tự giao)";
                                    isFreeShip = true;
                                } else {
                                    baseFeeNum   = Math.round(base / 1000) * 1000;          // ×1.0
                                    const total  = Math.round(base * multiplier / 1000) * 1000;
                                    surchargeNum = total - baseFeeNum;
                                    feeText = new Intl.NumberFormat("vi-VN").format(total) + " ₫";
                                    subText = eta;
                                }

                                if (isSelected) {
                                    initialFeeData = { baseFeeNum, surchargeNum, isContactOnly, isFreeShip };
                                }

                                const div = document.createElement("div");
                                div.style.cssText = "display:flex;align-items:center;justify-content:space-between;padding:0.65rem 0.85rem;border:1px solid var(--border);border-radius:8px;cursor:pointer;margin-bottom:0.45rem;transition:border-color .15s";
                                if (isSelected) div.style.borderColor = "var(--accent)";
                                div.innerHTML = `
                                    <label style="display:flex;align-items:center;gap:0.6rem;cursor:pointer;flex:1;">
                                        <input type="radio" name="__svcPick" value="${svc}" ${isSelected?"checked":""} style="accent-color:var(--accent);">
                                        <span>
                                            <strong style="font-size:0.88rem;">${labels[svc]}</strong>
                                            <small style="display:block;color:var(--text-muted);font-size:0.75rem;">${subText}</small>
                                        </span>
                                    </label>
                                    <span style="font-weight:700;color:var(--accent);font-size:0.9rem;white-space:nowrap;">${feeText}</span>`;
                                div.querySelector("input").addEventListener("change", function() {
                                    selectedServiceInput.value = svc;
                                    list.querySelectorAll("div").forEach(d => d.style.borderColor = "var(--border)");
                                    div.style.borderColor = "var(--accent)";
                                    // ── Cập nhật tóm tắt động ──
                                    window.updateSummaryFee?.(baseFeeNum, surchargeNum, isContactOnly, isFreeShip);
                                });
                                list.appendChild(div);
                            });

                            box.style.display = "block";

                            // Cập nhật summary cho dịch vụ đang được chọn
                            if (initialFeeData) {
                                window.updateSummaryFee?.(
                                    initialFeeData.baseFeeNum,
                                    initialFeeData.surchargeNum,
                                    initialFeeData.isContactOnly,
                                    initialFeeData.isFreeShip
                                );
                            }
                        }

                        let loadedProvinces = [];

                        fetch("https://provinces.open-api.vn/api/v2/p/")
                            .then(res => res.json())
                            .then(provinces => {
                                loadedProvinces = provinces;
                                provinces.forEach(p => {
                                    const opt = document.createElement("option");
                                    opt.value = p.code;
                                    opt.textContent = p.name;
                                    provinceSelect.appendChild(opt);
                                });

                                // Nếu đang dùng địa chỉ mặc định → tìm province code từ tên tỉnh
                                const isNew = (newRadio && newRadio.checked) || !defaultRadio;
                                if (!isNew) {
                                    const defAddr = document.getElementById("defaultAddressValue")?.value || "";
                                    const parts = defAddr.split(",").map(s => s.trim());
                                    const provinceName = parts[parts.length - 1]?.toLowerCase() || "";
                                    const found = provinces.find(p => p.name.toLowerCase().includes(provinceName) || provinceName.includes(p.name.toLowerCase().replace(/^tỉnh |^thành phố /, "")));
                                    if (found) {
                                        provinceCodeInput.value = found.code;
                                        renderShippingOptions(parseInt(found.code));
                                    }
                                }
                            })
                            .catch(err => console.error("Error loading provinces:", err));

                        provinceSelect.addEventListener("change", function () {
                            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                            wardSelect.disabled = true;

                            const pCode = this.value;
                            provinceCodeInput.value = pCode || "";
                            renderShippingOptions(pCode ? parseInt(pCode) : null);

                            if (!pCode) {
                                updateCombinedAddress();
                                return;
                            }

                            fetch(`https://provinces.open-api.vn/api/v2/p/${pCode}?depth=2`)
                                .then(res => res.json())
                                .then(data => {
                                    const wards = data.wards || [];
                                    wards.forEach(w => {
                                        const opt = document.createElement("option");
                                        opt.value = w.code;
                                        opt.textContent = w.name;
                                        wardSelect.appendChild(opt);
                                    });
                                    wardSelect.disabled = false;
                                    updateCombinedAddress();
                                })
                                .catch(err => console.error("Error loading wards:", err));
                        });

                        if (defaultRadio) {
                            defaultRadio.addEventListener("change", function() {
                                const defAddr = document.getElementById("defaultAddressValue")?.value || "";
                                const parts = defAddr.split(",").map(s => s.trim());
                                const provinceName = parts[parts.length - 1]?.toLowerCase() || "";
                                const found = loadedProvinces.find(p => p.name.toLowerCase().includes(provinceName) || provinceName.includes(p.name.toLowerCase().replace(/^tỉnh |^thành phố /, "")));
                                if (found) {
                                    provinceCodeInput.value = found.code;
                                    renderShippingOptions(parseInt(found.code));
                                }
                            });
                            newRadio?.addEventListener("change", function() {
                                provinceCodeInput.value = provinceSelect.value || "";
                                renderShippingOptions(provinceSelect.value ? parseInt(provinceSelect.value) : null);
                            });
                        }

                        wardSelect.addEventListener("change", updateCombinedAddress);
                        specificAddressInput.addEventListener("input", updateCombinedAddress);

                        function updateCombinedAddress() {
                            const isNew = (newRadio && newRadio.checked) || !defaultRadio;
                            if (isNew) {
                                const provinceName = provinceSelect.value ? provinceSelect.options[provinceSelect.selectedIndex].text : "";
                                const wardName = wardSelect.value ? wardSelect.options[wardSelect.selectedIndex].text : "";
                                const specific = specificAddressInput.value.trim();

                                if (provinceName || wardName || specific) {
                                    const parts = [specific, wardName, provinceName].filter(Boolean);
                                    shippingAddressCombined.value = parts.join(", ");
                                } else {
                                    shippingAddressCombined.value = "";
                                }
                            } else {
                                shippingAddressCombined.value = document.getElementById("defaultAddressValue") ? document.getElementById("defaultAddressValue").value : "";
                            }
                        }

                        form.addEventListener("submit", function (e) {
                            updateCombinedAddress();
                        });
                    });
                    </script>
                    <div id="shippingOptionsBox" style="display:none; margin-top:1rem;">
                        <label style="display:block; font-size:0.85rem; font-weight:600; color:var(--text-muted); margin-bottom:0.5rem;">Dịch vụ giao hàng</label>
                        <div id="shippingOptionsList"></div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Shipping.Notes">Ghi chú đơn hàng</label>
                        <input asp-for="Shipping.Notes" class="form-control" placeholder="Giao giờ hành chính, gọi trước..." />
                    </div>
                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top:.5rem;">
                        Tiếp tục → Chọn thanh toán
                    </button>
                </form>
            }
            else
            {
                <h2 style="margin:0 0 1.25rem; font-size:1.2rem;">Phương thức thanh toán</h2>
                <form asp-action="PlaceOrder" method="post" id="payment-form">
                    @Html.AntiForgeryToken()

                    <div class="payment-options">

                        <div>
                            <input type="radio" name="PaymentMethod" value="COD"
                                   id="pay-cod" class="payment-option" checked />
                            <label for="pay-cod" class="payment-label">
                                <span class="payment-icon">🚚</span>
                                <div class="payment-info">
                                    <strong>Thanh toán khi nhận hàng (COD)</strong>
                                    <span>Trả tiền mặt khi giao hàng đến tay</span>
                                </div>
                            </label>
                        </div>

                        <div>
                            <input type="radio" name="PaymentMethod" value="VNPay"
                                   id="pay-vnpay" class="payment-option" />
                            <label for="pay-vnpay" class="payment-label">
                                <span class="payment-icon">💳</span>
                                <div class="payment-info">
                                    <strong>VNPay</strong>
                                    <span>Thẻ ATM nội địa, Visa/Master, QR Code, Ví điện tử</span>
                                </div>
                                <span class="vnpay-badge">VNPay</span>
                            </label>
                        </div>

                    </div>

                    <div style="margin-bottom:1rem;">
                        <label style="display:block;font-size:.875rem;font-weight:500;margin-bottom:.35rem;">Mã giảm giá</label>
                        <div style="display:flex;gap:.5rem;">
                            <input type="text" id="discount-input" class="form-control" value="@sessionDiscountCode"
                                   placeholder="Nhập mã khuyến mãi" style="text-transform:uppercase;" />
                            <button type="button" id="apply-discount-btn" class="btn btn-ghost btn-sm" style="white-space:nowrap;">Áp dụng</button>
                        </div>
                        <div id="discount-msg" style="margin-top:.35rem;font-size:.8rem;">
                            @if (!string.IsNullOrEmpty(sessionDiscountCode))
                            {
                                <span style="color:#16a34a;">✓ Đã áp dụng mã @sessionDiscountCode thành công</span>
                            }
                        </div>
                    </div>

                    <div id="vnpay-note" style="display:none; background:#fffbeb; border:1px solid #fde68a;
                        border-radius:10px; padding:.85rem 1rem; font-size:.85rem; margin-bottom:1rem;">
                        ⚡ Bạn sẽ được chuyển hướng đến trang thanh toán <strong>VNPay</strong> an toàn.
                        Sau khi thanh toán xong, hệ thống tự động xác nhận đơn hàng.
                    </div>

                    <button type="submit" id="submit-btn" class="btn btn-primary" style="width:100%; margin-top:.25rem;">
                        Đặt hàng &amp; Thanh toán COD
                    </button>
                </form>

                <script>
                                (function () {
                                    var codRadio   = document.getElementById('pay-cod');
                                    var vnpRadio   = document.getElementById('pay-vnpay');
                                    var note       = document.getElementById('vnpay-note');
                                    var submitBtn  = document.getElementById('submit-btn');

                                    function updateUI() {
                                        if (vnpRadio.checked) {
                                            note.style.display = 'block';
                                            submitBtn.textContent = '💳 Chuyển đến VNPay để thanh toán';
                                        } else {
                                            note.style.display = 'none';
                                            submitBtn.textContent = 'Đặt hàng & Thanh toán COD';
                                        }
                                    }
                                    codRadio.addEventListener('change', updateUI);
                                    vnpRadio.addEventListener('change', updateUI);

                                    // Đồng bộ biến tính tiền trong Javascript từ dữ liệu của Model
                                    var subtotal = @Model.Cart.Subtotal;
                                    var originalShipping = @((decimal?)ViewBag.OriginalShippingFee ?? Model.ShippingFee);
                                    var shipping = @Model.ShippingFee;
                                    var appliedDiscount = @serverDiscountAmount;
                                    var isCongKenhStep2 = @(((int)(ViewBag.CartShippingClassIndex ?? 0)) == 2 ? "true" : "false");

                                    function formatVND(n) {
                                        return new Intl.NumberFormat('vi-VN').format(n) + ' ₫';
                                    }

                                    document.getElementById('apply-discount-btn').addEventListener('click', function () {
                                        var code = document.getElementById('discount-input').value.trim();
                                        if (!code) return;

                                        fetch('/Checkout/ApplyDiscount', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ code: code })
                                        })
                                        .then(function(r) { return r.json(); })
                                        .then(function(data) {
                                            var msg = document.getElementById('discount-msg');
                                            if (data.success) {
                                                appliedDiscount = data.discountAmount;
                                                if (data.isFreeShipping) {
                                                    shipping = 0;
                                                } else {
                                                    shipping = originalShipping;
                                                }
                                                msg.style.color = '#16a34a';
                                                msg.textContent = '✓ ' + data.message;
                                                
                                                if (appliedDiscount > 0) {
                                                    document.getElementById('discount-row').style.display = 'flex';
                                                    document.getElementById('discount-value').textContent = '-' + formatVND(appliedDiscount);
                                                } else {
                                                    document.getElementById('discount-row').style.display = 'none';
                                                }
                                                
                                                document.getElementById('shipping-fee-display').textContent = formatVND(shipping);
                                                document.getElementById('total-price').textContent = formatVND(subtotal - appliedDiscount + shipping);
                                            } else {
                                                appliedDiscount = 0;
                                                shipping = originalShipping;
                                                msg.style.color = '#ef4444';
                                                msg.textContent = '✗ ' + data.message;
                                                document.getElementById('discount-row').style.display = 'none';
                                                document.getElementById('shipping-fee-display').textContent = formatVND(shipping);
                                                document.getElementById('total-price').textContent = formatVND(subtotal + shipping);
                                            }
                                        });
                                    });
                                })();
                </script>
            }
        </div>

        <div style="display:flex; flex-direction:column; gap:1rem;">
            <div class="glass-panel" style="padding:1.25rem;">
                <h3 style="margin:0 0 1rem; font-size:1rem; font-weight:700;">Tóm tắt đơn hàng</h3>

                @foreach (var item in Model.Cart.Items)
                {
                    <div class="summary-product">
                        <span style="color:var(--text); max-width:65%;">@item.Name <span style="color:var(--text-muted);">× @item.Quantity</span></span>
                        <span style="font-weight:600;">@item.LineTotal.ToString("N0") ₫</span>
                    </div>
                }

                @{
                    var ckIdx  = (int)(ViewBag.CartShippingClassIndex ?? 0);
                    var isCkCart = ckIdx == 2;
                    var ckFree   = ViewBag.CongKenhIsFree is bool ckb && ckb;
                    // For step 2 determine text to display
                    string shipFeeText, bulkyFeeText, totalText;
                    if (Model.Step == 1) {
                        shipFeeText = ""; bulkyFeeText = ""; totalText = "";
                    } else if (isCkCart) {
                        shipFeeText  = ckFree ? "Miễn phí" : "Liên hệ";
                        bulkyFeeText = ckFree ? "Miễn phí" : "Liên hệ";
                        totalText    = ckFree
                            ? (Model.Cart.Subtotal - serverDiscountAmount).ToString("N0") + " ₫"
                            : (Model.Cart.Subtotal - serverDiscountAmount).ToString("N0") + " ₫ + phí ship";
                    } else {
                        shipFeeText = Model.ShippingFee.ToString("N0") + " ₫";
                        bulkyFeeText = "";
                        totalText   = (Model.Cart.Subtotal - serverDiscountAmount + Model.ShippingFee).ToString("N0") + " ₫";
                    }
                }
                <div style="margin-top:.75rem;">
                    <div class="summary-item">
                        <span>Tạm tính</span>
                        <span>@Model.Cart.Subtotal.ToString("N0") ₫</span>
                    </div>

                    <div class="summary-item" id="discount-row" style="display: @(serverDiscountAmount > 0 ? "flex" : "none"); color:#16a34a;">
                        <span>Giảm giá</span>
                        <span id="discount-value">-@serverDiscountAmount.ToString("N0") ₫</span>
                    </div>

                    <div class="summary-item">
                        <span>Phí vận chuyển</span>
                        <span id="shipping-fee-display">
                            @if (Model.Step == 1)
                            {
                                <span style="color:var(--text-muted);font-style:italic;">Chưa chọn</span>
                            }
                            else if (isCkCart && ckFree)
                            {
                                <span style="color:#16a34a;">Miễn phí</span>
                            }
                            else if (isCkCart)
                            {
                                <span style="color:var(--text-muted);">Liên hệ</span>
                            }
                            else
                            {
                                @Model.ShippingFee.ToString("N0")
                                <text> ₫</text>
                            }
                        </span>
                    </div>

                    @if (isCkCart)
                    {
                        <div class="summary-item" id="bulky-row"
                             style="@(Model.Step == 1 ? "display:none;" : "") color:#f59e0b; font-size:0.82rem;">
                            <span>📦 Phụ phí hàng cồng kềnh</span>
                            <span id="bulky-fee-display">
                                @if (Model.Step == 1)
                                {
                                    <span>—</span>
                                }
                                else if (ckFree)
                                {
                                    <span style="color:#16a34a;">Miễn phí</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">Liên hệ</span>
                                }
                            </span>
                        </div>
                    }

                    <div class="summary-item total">
                        <span>Tổng cộng</span>
                        <span class="price" id="total-price">
                            @if (Model.Step == 1)
                            {
                                <span style="color:var(--text-muted);font-size:.85rem;font-weight:500;">Chờ chọn dịch vụ</span>
                            }
                            else if (isCkCart && !ckFree)
                            {
                                @((Model.Cart.Subtotal - serverDiscountAmount).ToString("N0"))
                                <text> ₫ </text>
                                <small style="font-size:.7rem;color:var(--text-muted);">+ phí ship</small>
                            }
                            else
                            {
                                @((Model.Cart.Subtotal - serverDiscountAmount + Model.ShippingFee).ToString("N0"))
                                <text> ₫</text>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <!-- Chọn Voucher giảm giá box -->
            <div class="glass-panel" style="padding:1.25rem;">
                <h3 style="margin:0 0 1rem; font-size:1rem; font-weight:700; display:flex; align-items:center; gap:0.35rem;">
                    <span>🎫</span> Chọn Voucher của bạn
                </h3>
                
                @{
                    var userVouchers = ViewBag.UserVouchers as List<WebApplication1.Models.Discount> ?? new();
                }

                @if (!userVouchers.Any())
                {
                    <p style="font-size:0.85rem; color:var(--text-muted); margin:0; text-align:center;">Bạn không có voucher khả dụng nào.</p>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:0.75rem; max-height:220px; overflow-y:auto; padding-right:0.25rem;">
                        @foreach (var v in userVouchers)
                        {
                            var isApplied = sessionDiscountCode == v.Code;
                            var leftVal = v.DiscountType == DiscountType.Percent ? $"{v.Value:N0}%" : $"{v.Value / 1000:N0}K";
                            var desc = v.PromotionType == PromotionType.FreeShipping ? "Miễn phí vận chuyển" : $"Giảm {v.Value:N0}₫ cho đơn từ {v.MinOrderAmount:N0}₫";
                            var ticketColor = v.PromotionType == PromotionType.FreeShipping ? "#10b981" : (v.PromotionType == PromotionType.FirstOrder ? "#f59e0b" : "#8b5cf6");
                            var ticketBg = v.PromotionType == PromotionType.FreeShipping ? "#f0fdf4" : (v.PromotionType == PromotionType.FirstOrder ? "#fffbeb" : "#f5f3ff");

                            <div class="checkout-voucher-card" 
                                 style="display:flex; align-items:center; border:1.5px solid @(isApplied ? ticketColor : "var(--border)"); 
                                        border-radius:10px; background:@ticketBg; padding:0.6rem; cursor:pointer; transition:all 0.15s;
                                        position:relative; overflow:hidden;"
                                 onclick="selectVoucherCode('@v.Code')">
                                 
                                 <div style="width:4px; height:100%; background:@ticketColor; position:absolute; left:0; top:0; bottom:0;"></div>
                                 
                                 <div style="flex:1; padding-left:0.5rem; display:flex; flex-direction:column; gap:0.15rem;">
                                     <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                                         <strong style="font-size:0.85rem; color:@ticketColor;">@v.Code</strong>
                                         @if (isApplied)
                                         {
                                             <span style="font-size:0.7rem; color:#fff; background:@ticketColor; padding:1px 5px; border-radius:4px; font-weight:600;">Đang dùng</span>
                                         }
                                     </div>
                                     <span style="font-size:0.75rem; color:var(--text-muted);">@desc</span>
                                 </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <script>
        // ── Cập nhật tóm tắt phí ship động (được gọi từ step 1) ──────────────────
        (function () {
            var subtotal      = @Model.Cart.Subtotal;
            var isCongKenhJs  = @(((int)(ViewBag.CartShippingClassIndex ?? 0)) == 2 ? "true" : "false");

            function fmt(n) {
                return new Intl.NumberFormat('vi-VN').format(n) + ' ₫';
            }
            function getDiscount() {
                var el = document.getElementById('discount-value');
                if (!el) return 0;
                return parseInt(el.textContent.replace(/[^0-9]/g, '')) || 0;
            }

            window.updateSummaryFee = function (baseFee, surcharge, isContactOnly, isFree) {
                var shipEl   = document.getElementById('shipping-fee-display');
                var bulkyRow = document.getElementById('bulky-row');
                var bulkyEl  = document.getElementById('bulky-fee-display');
                var totalEl  = document.getElementById('total-price');
                var discount = getDiscount();

                if (isContactOnly) {
                    if (shipEl)   shipEl.innerHTML  = '<span style="color:var(--text-muted);font-style:italic;">Liên hệ</span>';
                    if (bulkyRow) bulkyRow.style.display = 'flex';
                    if (bulkyEl)  bulkyEl.innerHTML = '<span style="color:var(--text-muted);font-style:italic;">Liên hệ</span>';
                    if (totalEl)  totalEl.innerHTML =
                        '<span>' + fmt(subtotal - discount) + '</span>' +
                        '<small style="color:var(--text-muted);font-size:.7rem;"> + phí ship</small>';
                } else if (isFree) {
                    if (shipEl)   shipEl.innerHTML  = '<span style="color:#16a34a;">Miễn phí</span>';
                    if (bulkyRow && isCongKenhJs) { bulkyRow.style.display = 'flex'; }
                    if (bulkyEl)  bulkyEl.innerHTML = '<span style="color:#16a34a;">Miễn phí (shop tự giao)</span>';
                    if (totalEl)  totalEl.textContent = fmt(subtotal - discount);
                } else {
                    if (shipEl)  shipEl.textContent = fmt(baseFee);
                    if (surcharge > 0) {
                        if (bulkyRow) bulkyRow.style.display = 'flex';
                        if (bulkyEl)  bulkyEl.textContent    = '+' + fmt(surcharge);
                    } else if (bulkyRow) {
                        bulkyRow.style.display = 'none';
                    }
                    if (totalEl) totalEl.textContent = fmt(subtotal - discount + baseFee + surcharge);
                }
            };
        })();

        function selectVoucherCode(code) {
            var currentCode = '@sessionDiscountCode';
            var targetCode = (currentCode === code) ? '' : code;

            var input = document.getElementById('discount-input');
            var btn = document.getElementById('apply-discount-btn');
            if (input && btn) {
                input.value = targetCode;
                btn.click();
            } else {
                fetch('/Checkout/ApplyDiscount', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: targetCode })
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                });
            }
        }
        </script>

    </div>
</div>