@model WebApplication1.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";

    // Lấy thông tin mã giảm giá và số tiền từ Session hoặc TempData do Controller đẩy sang (nếu có)
    var sessionDiscountCode = Context.Session.GetString("AppliedCouponCode") ?? "";
    var sessionDiscountAmountStr = Context.Session.GetString("DiscountAmount") ?? "0";
    decimal serverDiscountAmount = 0;
    decimal.TryParse(sessionDiscountAmountStr, out serverDiscountAmount);
}

<style>
    .checkout-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 1.5rem;
        align-items: start;
    }

    .checkout-step-bar {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 1.75rem;
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
    }

        .step-item.active {
            color: var(--accent);
        }

        .step-item.done {
            color: #16a34a;
        }

    .step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
        background: #f3f4f6;
        color: var(--text-muted);
        border: 2px solid #e5e7eb;
    }

    .step-item.active .step-num {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }

    .step-item.done .step-num {
        background: #16a34a;
        color: #fff;
        border-color: #16a34a;
    }

    .step-divider {
        flex: 1;
        height: 2px;
        background: #e5e7eb;
        margin: 0 12px;
        max-width: 60px;
    }

        .step-divider.done {
            background: #16a34a;
        }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.35rem;
            color: var(--text);
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.9rem;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: 0.9rem;
        font-family: inherit;
        outline: none;
        transition: border-color .15s;
        background: #fff;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: var(--accent);
        }

    /* ── Payment options ── */
    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .payment-option {
        display: none;
    }

    .payment-label {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 1rem 1.25rem;
        border: 2px solid var(--border);
        border-radius: 12px;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }

    .payment-option:checked + .payment-label {
        border-color: var(--accent);
        background: var(--accent-light);
    }

    .payment-icon {
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .payment-info strong {
        display: block;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .payment-info span {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .vnpay-badge {
        margin-left: auto;
        background: #e8253a;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        letter-spacing: 0.3px;
    }

    /* ── Order summary ── */
    .summary-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.875rem;
        padding: 0.35rem 0;
    }

        .summary-item.total {
            font-weight: 700;
            font-size: 1rem;
            border-top: 1px solid var(--border);
            margin-top: 0.5rem;
            padding-top: 0.75rem;
        }

            .summary-item.total .price {
                color: var(--accent);
            }

    .summary-product {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-size: 0.875rem;
    }

        .summary-product + .summary-product {
            border-top: 1px dashed #f3f4f6;
        }

    @@media (max-width: 720px) {
        .checkout-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div style="padding-top:1.5rem; padding-bottom:3rem;">

    <div class="checkout-step-bar">
        <div class="step-item @(Model.Step >= 1 ? (Model.Step > 1 ? "done" : "active") : "")">
            <div class="step-num">@(Model.Step > 1 ? "✓" : "1")</div>
            <span>Giao hàng</span>
        </div>
        <div class="step-divider @(Model.Step > 1 ? "done" : "")"></div>
        <div class="step-item @(Model.Step == 2 ? "active" : "")">
            <div class="step-num">2</div>
            <span>Thanh toán</span>
        </div>
    </div>

    <div class="checkout-layout">

        <div class="glass-panel" style="padding:1.5rem;">

            @if (Model.Step == 1)
            {
                <h2 style="margin:0 0 1.25rem; font-size:1.2rem;">Thông tin giao hàng</h2>
                <form asp-action="Shipping" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger" style="margin-bottom:.75rem;"></div>

                    <div class="form-group">
                        <label asp-for="Shipping.FullName">Họ và tên *</label>
                        <input asp-for="Shipping.FullName" class="form-control" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="Shipping.FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Shipping.Phone">Số điện thoại *</label>
                        <input asp-for="Shipping.Phone" class="form-control" placeholder="0912 345 678" />
                        <span asp-validation-for="Shipping.Phone" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Địa chỉ nhận hàng *</label>
                        @if (!string.IsNullOrEmpty(Model.Shipping.ShippingAddress))
                        {
                            <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:0.75rem;">
                                <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal; cursor:pointer;">
                                    <input type="radio" name="AddressType" value="default" id="addressTypeDefault" checked />
                                    <span>Sử dụng địa chỉ mặc định: <strong>@Model.Shipping.ShippingAddress</strong></span>
                                </label>
                                <label style="display:flex; align-items:center; gap:0.5rem; font-weight:normal; cursor:pointer;">
                                    <input type="radio" name="AddressType" value="new" id="addressTypeNew" />
                                    <span>Giao đến địa chỉ mới</span>
                                </label>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="AddressType" value="new" id="addressTypeNew" />
                        }

                        <div id="defaultAddressWrapper" style="display: @(string.IsNullOrEmpty(Model.Shipping.ShippingAddress) ? "none" : "block"); margin-bottom: 0.5rem;">
                            <input type="hidden" id="defaultAddressValue" value="@Model.Shipping.ShippingAddress" />
                        </div>

                        <div id="newAddressWrapper" style="display: @(string.IsNullOrEmpty(Model.Shipping.ShippingAddress) ? "block" : "none"); border: 1px solid var(--border); padding: 1rem; border-radius: 10px; background: rgba(0,0,0,0.01); margin-bottom: 0.75rem;">
                            <div style="display:grid; grid-template-columns:1fr; gap:0.75rem;">
                                <div>
                                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Tỉnh / Thành phố *</label>
                                    <select id="provinceSelect" class="form-control">
                                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Phường / Xã *</label>
                                    <select id="wardSelect" class="form-control" disabled>
                                        <option value="">-- Chọn Phường/Xã --</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Số nhà, tên đường (Địa chỉ cụ thể) *</label>
                                    <input type="text" id="specificAddress" class="form-control" placeholder="Số nhà, tên đường..." />
                                </div>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Shipping.ShippingAddress" id="shippingAddressCombined" />
                        <span asp-validation-for="Shipping.ShippingAddress" class="text-danger"></span>
                    </div>

                    <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const defaultRadio = document.getElementById("addressTypeDefault");
                        const newRadio = document.getElementById("addressTypeNew");
                        const newAddressWrapper = document.getElementById("newAddressWrapper");
                        const provinceSelect = document.getElementById("provinceSelect");
                        const wardSelect = document.getElementById("wardSelect");
                        const specificAddressInput = document.getElementById("specificAddress");
                        const shippingAddressCombined = document.getElementById("shippingAddressCombined");
                        const form = shippingAddressCombined.closest("form");

                        function toggleAddressFields() {
                            const isNew = (newRadio && newRadio.checked) || !defaultRadio;
                            if (isNew) {
                                newAddressWrapper.style.display = "block";
                                provinceSelect.required = true;
                                wardSelect.required = true;
                                specificAddressInput.required = true;
                            } else {
                                newAddressWrapper.style.display = "none";
                                provinceSelect.required = false;
                                wardSelect.required = false;
                                specificAddressInput.required = false;
                            }
                        }

                        if (defaultRadio && newRadio) {
                            defaultRadio.addEventListener("change", toggleAddressFields);
                            newRadio.addEventListener("change", toggleAddressFields);
                        }

                        toggleAddressFields();

                        fetch("https://provinces.open-api.vn/api/v2/p/")
                            .then(res => res.json())
                            .then(provinces => {
                                provinces.forEach(p => {
                                    const opt = document.createElement("option");
                                    opt.value = p.code;
                                    opt.textContent = p.name;
                                    provinceSelect.appendChild(opt);
                                });
                            })
                            .catch(err => console.error("Error loading provinces:", err));

                        provinceSelect.addEventListener("change", function () {
                            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                            wardSelect.disabled = true;

                            const pCode = this.value;
                            if (!pCode) {
                                updateCombinedAddress();
                                return;
                            }

                            fetch(`https://provinces.open-api.vn/api/v2/p/${pCode}?depth=2`)
                                .then(res => res.json())
                                .then(data => {
                                    const wards = data.wards || [];
                                    wards.forEach(w => {
                                        const opt = document.createElement("option");
                                        opt.value = w.code;
                                        opt.textContent = w.name;
                                        wardSelect.appendChild(opt);
                                    });
                                    wardSelect.disabled = false;
                                    updateCombinedAddress();
                                })
                                .catch(err => console.error("Error loading wards:", err));
                        });

                        wardSelect.addEventListener("change", updateCombinedAddress);
                        specificAddressInput.addEventListener("input", updateCombinedAddress);

                        function updateCombinedAddress() {
                            const isNew = (newRadio && newRadio.checked) || !defaultRadio;
                            if (isNew) {
                                const provinceName = provinceSelect.value ? provinceSelect.options[provinceSelect.selectedIndex].text : "";
                                const wardName = wardSelect.value ? wardSelect.options[wardSelect.selectedIndex].text : "";
                                const specific = specificAddressInput.value.trim();

                                if (provinceName || wardName || specific) {
                                    const parts = [specific, wardName, provinceName].filter(Boolean);
                                    shippingAddressCombined.value = parts.join(", ");
                                } else {
                                    shippingAddressCombined.value = "";
                                }
                            } else {
                                shippingAddressCombined.value = document.getElementById("defaultAddressValue") ? document.getElementById("defaultAddressValue").value : "";
                            }
                        }

                        form.addEventListener("submit", function (e) {
                            updateCombinedAddress();
                        });
                    });
                    </script>
                    <div class="form-group" style="margin-top: 1rem;">
                        <label>Khu vực giao hàng *</label>
                        <select asp-for="Shipping.IsNgoaiThanh" id="isNgoaiThanhSelect" class="form-control">
                            <option value="false">Nội thành TP. Hồ Chí Minh (Cố định 40k dưới 10km, sau đó +4k/km)</option>
                            <option value="true">Ngoại thành TP. Hồ Chí Minh / Tỉnh thành khác (Cố định 60k dưới 20km, cứ thêm 20km +20k)</option>
                        </select>
                    </div>

                    <div class="form-group" id="distanceWrapper" style="display:none;">
                        <label asp-for="Shipping.DistanceKm">Khoảng cách giao hàng tự động (km)</label>
                        <input asp-for="Shipping.DistanceKm" type="number" step="0.1" id="distanceInput" class="form-control" placeholder="Tự động tính km..." min="0" readonly />
                        <span asp-validation-for="Shipping.DistanceKm" class="text-danger"></span>
                    </div>

                    <!-- Live Shipping Fee Estimate Preview -->
                    <div class="glass-panel" id="shipping-estimate-box" style="padding:1rem; margin:1rem 0; border:1px dashed var(--accent); border-radius:10px; display:flex; justify-content:space-between; align-items:center; background:var(--accent-light);">
                        <div>
                            <strong style="font-size:0.88rem; display:block; color:var(--text);">Ước tính phí vận chuyển</strong>
                            <span id="shipping-breakdown" style="font-size:0.75rem; color:var(--text-muted);">Đang tính toán...</span>
                        </div>
                        <span id="shipping-estimate-amount" style="font-size:1.15rem; font-weight:700; color:var(--accent);">40.000 ₫</span>
                    </div>

                    <script>
                        // Dữ liệu giỏ hàng phục vụ tính phí ship trực tiếp client-side
                        const cartItems = [
                            @foreach (var item in Model.Cart.Items)
                            {
                                <text>{ name: "@Html.Raw(item.Name)", quantity: @item.Quantity, isBulky: @(item.IsBulky ? "true" : "false") },</text>
                            }
                        ];

                        document.addEventListener("DOMContentLoaded", function () {
                            const isNgoaiSelect = document.getElementById("isNgoaiThanhSelect");
                            const distanceWrapper = document.getElementById("distanceWrapper");
                            const distanceInput = document.getElementById("distanceInput");
                            const breakdownEl = document.getElementById("shipping-breakdown");
                            const amountEl = document.getElementById("shipping-estimate-amount");

                            // Shop coordinates: 10/80c Song Hành Xa Lộ Hà Nội, Tăng Nhơn Phú, Hồ Chí Minh, Việt Nam
                            const startLat = 10.8407;
                            const startLon = 106.7808;

                            async function fetchCoords(query) {
                                try {
                                    const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=1`;
                                    const res = await fetch(url, { headers: { "Accept-Language": "vi,en;q=0.9" } });
                                    if (res.ok) {
                                        const data = await res.json();
                                        if (data && data.length > 0) {
                                            return { lat: parseFloat(data[0].lat), lon: parseFloat(data[0].lon) };
                                        }
                                    }
                                } catch (e) {
                                    console.error("OSM Geocoding error:", e);
                                }
                                return null;
                            }

                            async function getGeocodedCoordinates(specific, ward, district, province) {
                                // Chain 1: Full address
                                let q = `${specific}, ${ward}, ${district}, ${province}, Việt Nam`;
                                let coords = await fetchCoords(q);
                                if (coords) return coords;

                                // Chain 2: Ward + District + Province
                                if (ward && district) {
                                    q = `${ward}, ${district}, ${province}, Việt Nam`;
                                    coords = await fetchCoords(q);
                                    if (coords) return coords;
                                }

                                // Chain 3: District + Province
                                if (district) {
                                    q = `${district}, ${province}, Việt Nam`;
                                    coords = await fetchCoords(q);
                                    if (coords) return coords;
                                }

                                // Chain 4: Province only
                                q = `${province}, Việt Nam`;
                                return await fetchCoords(q);
                            }

                            async function getActualDistanceOSM(specific, ward, district, province) {
                                const coords = await getGeocodedCoordinates(specific, ward, district, province);
                                if (!coords) return null;

                                try {
                                    const routeUrl = `https://router.project-osrm.org/route/v1/driving/${startLon},${startLat};${coords.lon},${coords.lat}?overview=false`;
                                    const routeResponse = await fetch(routeUrl);
                                    if (!routeResponse.ok) return null;
                                    
                                    const routeData = await routeResponse.json();
                                    if (!routeData.routes || routeData.routes.length === 0) return null;

                                    const distanceMeters = routeData.routes[0].distance;
                                    return distanceMeters / 1000.0; // km
                                } catch (e) {
                                    console.error("OSRM Routing error:", e);
                                    return null;
                                }
                            }

                            async function getActualDistanceOSMSingle(address) {
                                const coords = await fetchCoords(address + ", Việt Nam");
                                if (!coords) return null;

                                try {
                                    const routeUrl = `https://router.project-osrm.org/route/v1/driving/${startLon},${startLat};${coords.lon},${coords.lat}?overview=false`;
                                    const routeResponse = await fetch(routeUrl);
                                    if (!routeResponse.ok) return null;
                                    
                                    const routeData = await routeResponse.json();
                                    if (!routeData.routes || routeData.routes.length === 0) return null;

                                    const distanceMeters = routeData.routes[0].distance;
                                    return distanceMeters / 1000.0; // km
                                } catch (e) {
                                    console.error("OSRM Routing error:", e);
                                    return null;
                                }
                            }

                            function calculateAutomaticDistance(address) {
                                if (!address) return 0;
                                const addr = address.toLowerCase();
                                
                                // 1. Check province
                                if (addr.includes("hồ chí minh") || addr.includes("hcm")) {
                                    if (addr.includes("quận 7") || addr.includes("q.7") || addr.includes("q7")) return 12.5;
                                    if (addr.includes("quận 12") || addr.includes("q.12") || addr.includes("q12")) return 18.0;
                                    if (addr.includes("bình tân")) return 16.0;
                                    if (addr.includes("thủ đức")) return 5.0; // Rất gần Tăng Nhơn Phú
                                    if (addr.includes("tăng nhơn phú")) return 1.5;
                                    if (addr.includes("hóc môn")) return 22.0;
                                    if (addr.includes("bình chánh")) return 25.0;
                                    if (addr.includes("nhà bè")) return 28.0;
                                    if (addr.includes("củ chi")) return 45.0;
                                    if (addr.includes("cần giờ")) return 65.0;
                                    
                                    return 8.0;
                                }
                                
                                if (addr.includes("bình dương")) return 30.0;
                                if (addr.includes("đồng nai")) return 25.0;
                                if (addr.includes("long an")) return 50.0;
                                if (addr.includes("tây ninh")) return 90.0;
                                if (addr.includes("vũng tàu") || addr.includes("bà rịa")) return 95.0;
                                if (addr.includes("tiền giang")) return 80.0;
                                if (addr.includes("bến tre")) return 100.0;
                                if (addr.includes("vĩnh long")) return 130.0;
                                if (addr.includes("cần thơ")) return 170.0;
                                if (addr.includes("đồng tháp")) return 145.0;
                                if (addr.includes("trà vinh")) return 140.0;
                                
                                if (addr.includes("đà nẵng")) return 960.0;
                                if (addr.includes("hà nội")) return 1720.0;
                                if (addr.includes("hải phòng")) return 1700.0;
                                if (addr.includes("lâm đồng") || addr.includes("đà lạt")) return 310.0;
                                if (addr.includes("khánh hòa") || addr.includes("nha trang")) return 430.0;
                                
                                return 150.0; // Tỉnh khác mặc định
                            }

                            function updateShippingEstimate() {
                                const isNgoai = isNgoaiSelect.value === "true";
                                const provinceSelect = document.getElementById("provinceSelect");
                                const defaultRadio = document.getElementById("addressTypeDefault");
                                
                                let prov = provinceSelect ? (provinceSelect.options[provinceSelect.selectedIndex]?.text || "") : "";
                                const isNew = (document.getElementById("addressTypeNew") && document.getElementById("addressTypeNew").checked) || !defaultRadio;
                                
                                let currentAddr = "";
                                if (isNew) {
                                    const wardSelect = document.getElementById("wardSelect");
                                    const wardText = wardSelect ? (wardSelect.options[wardSelect.selectedIndex]?.text || "") : "";
                                    const specificVal = document.getElementById("specificAddress").value.trim();

                                    const parts = [specificVal, wardText, prov].filter(Boolean);
                                    currentAddr = parts.join(", ");
                                } else {
                                    currentAddr = document.getElementById("defaultAddressValue") ? document.getElementById("defaultAddressValue").value : "";
                                }

                                const isHCM = currentAddr.toLowerCase().includes("hồ chí minh") || currentAddr.toLowerCase().includes("hcm");
                                distanceWrapper.style.display = "block";

                                const dist = parseFloat(distanceInput.value) || 0;
                                
                                // 1. Base fee
                                let baseFee = 40000;
                                let explanation = "";
                                
                                const isOuter = isNgoai || !isHCM;
                                
                                 if (isOuter) {
                                     baseFee = 60000;
                                     explanation = `Ngoại thành / Liên tỉnh (${dist.toFixed(1)} km): Cố định 60.000 ₫`;
                                     if (dist > 20) {
                                         const extra = dist - 20;
                                         const blocks = Math.ceil(extra / 20);
                                         baseFee += blocks * 20000;
                                         explanation += ` + ${new Intl.NumberFormat('vi-VN').format(blocks * 20000)} ₫ cho thêm ${blocks} block 20km`;
                                     }
                                 } else {
                                     baseFee = 40000;
                                     explanation = `Nội thành TP.HCM (${dist.toFixed(1)} km): Cố định 40.000 ₫`;
                                     if (dist > 10) {
                                         const extra = dist - 10;
                                         baseFee += extra * 4000;
                                         explanation += ` + ${new Intl.NumberFormat('vi-VN').format(extra * 4000)} ₫ cho thêm ${extra.toFixed(1)} km`;
                                     }
                                 }

                                // 2. Bulky surcharge
                                let bulkySurcharge = 0;
                                let bulkyDetails = [];
                                cartItems.forEach(item => {
                                    if (item.isBulky) {
                                        if (item.name.toLowerCase().includes("bàn")) {
                                            const surcharge = 30000 * item.quantity;
                                            bulkySurcharge += surcharge;
                                            bulkyDetails.push(`Phụ phí Bàn: +${new Intl.NumberFormat('vi-VN').format(surcharge)} ₫ (${item.quantity} cái)`);
                                        } else if (item.name.toLowerCase().includes("ghế")) {
                                            const surcharge = 15000 * item.quantity;
                                            bulkySurcharge += surcharge;
                                            bulkyDetails.push(`Phụ phí Ghế: +${new Intl.NumberFormat('vi-VN').format(surcharge)} ₫ (${item.quantity} cái)`);
                                        } else {
                                            const surcharge = 20000 * item.quantity;
                                            bulkySurcharge += surcharge;
                                            bulkyDetails.push(`Cồng kềnh: +${new Intl.NumberFormat('vi-VN').format(surcharge)} ₫ (${item.quantity} cái)`);
                                        }
                                    }
                                });

                                const totalFee = baseFee + bulkySurcharge;
                                amountEl.textContent = new Intl.NumberFormat('vi-VN').format(totalFee) + ' ₫';
                                
                                if (bulkyDetails.length > 0) {
                                    breakdownEl.innerHTML = `${explanation}<br>${bulkyDetails.join('<br>')}`;
                                } else {
                                    breakdownEl.textContent = explanation;
                                }
                            }

                            if (isNgoaiSelect && distanceInput) {
                                isNgoaiSelect.addEventListener("change", updateShippingEstimate);

                                const provinceSelect = document.getElementById("provinceSelect");
                                const wardSelect = document.getElementById("wardSelect");
                                const specificAddressInput = document.getElementById("specificAddress");
                                const defaultRadio = document.getElementById("addressTypeDefault");

                                let lastRequestTime = 0;

                                async function handleAddressStateChange() {
                                    const isNew = (document.getElementById("addressTypeNew") && document.getElementById("addressTypeNew").checked) || !defaultRadio;
                                    let addressStr = "";
                                    let prov = "";
                                    let ward = "";
                                    let specific = "";

                                    if (isNew) {
                                        prov = provinceSelect.value ? provinceSelect.options[provinceSelect.selectedIndex].text : "";
                                        ward = wardSelect.value ? wardSelect.options[wardSelect.selectedIndex].text : "";
                                        specific = specificAddressInput.value.trim();

                                        addressStr = [specific, ward, prov].filter(Boolean).join(", ");
                                    } else {
                                        addressStr = document.getElementById("defaultAddressValue")?.value || "";
                                    }

                                    const isHCM = addressStr.toLowerCase().includes("hồ chí minh") || addressStr.toLowerCase().includes("hcm");

                                    if (isNew && (!prov || !ward || !specific)) {
                                        distanceInput.value = "0.0";
                                        breakdownEl.innerHTML = `<span style="color:var(--text-muted);">Vui lòng nhập đầy đủ thông tin địa chỉ để định vị.</span>`;
                                        amountEl.textContent = "Chờ định vị...";
                                        return;
                                    }

                                    breakdownEl.innerHTML = `<span style="color:var(--accent);">⏳ Đang định vị địa chỉ và tính toán khoảng cách thực tế từ cửa hàng...</span>`;
                                    amountEl.textContent = "...";

                                    const reqTime = Date.now();
                                    lastRequestTime = reqTime;

                                    await new Promise(resolve => setTimeout(resolve, 800));
                                    if (reqTime !== lastRequestTime) return;

                                    let distance = null;
                                    if (isNew) {
                                        distance = await getActualDistanceOSM(specific, ward, "", prov);
                                    } else if (addressStr) {
                                        distance = await getActualDistanceOSMSingle(addressStr);
                                    }

                                    if (reqTime !== lastRequestTime) return;

                                    if (distance === null) {
                                        distanceInput.value = "0.0";
                                        breakdownEl.innerHTML = `<span style="color:#ef4444; font-weight: 500;">⚠️ Không thể định vị địa chỉ này. Vui lòng kiểm tra lại.</span>`;
                                        amountEl.textContent = "Chờ định vị...";
                                        return;
                                    }

                                    distanceInput.value = distance.toFixed(1);

                                    if (isHCM) {
                                        isNgoaiSelect.value = distance > 15 ? "true" : "false";
                                    } else {
                                        isNgoaiSelect.value = "true";
                                    }

                                    updateShippingEstimate();
                                }

                                if (defaultRadio) {
                                    defaultRadio.addEventListener("change", handleAddressStateChange);
                                    const newRadio = document.getElementById("addressTypeNew");
                                    if (newRadio) newRadio.addEventListener("change", handleAddressStateChange);
                                }
                                if (provinceSelect) provinceSelect.addEventListener("change", handleAddressStateChange);
                                if (wardSelect) wardSelect.addEventListener("change", handleAddressStateChange);
                                if (specificAddressInput) specificAddressInput.addEventListener("input", handleAddressStateChange);

                                handleAddressStateChange();
                            }
                        });
                    </script>

                    <div class="form-group">
                        <label asp-for="Shipping.Notes">Ghi chú đơn hàng</label>
                        <input asp-for="Shipping.Notes" class="form-control" placeholder="Giao giờ hành chính, gọi trước..." />
                    </div>
                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top:.5rem;">
                        Tiếp tục → Chọn thanh toán
                    </button>
                </form>
            }
            else
            {
                <h2 style="margin:0 0 1.25rem; font-size:1.2rem;">Phương thức thanh toán</h2>
                <form asp-action="PlaceOrder" method="post" id="payment-form">
                    @Html.AntiForgeryToken()

                    <div class="payment-options">

                        <div>
                            <input type="radio" name="PaymentMethod" value="COD"
                                   id="pay-cod" class="payment-option" checked />
                            <label for="pay-cod" class="payment-label">
                                <span class="payment-icon">🚚</span>
                                <div class="payment-info">
                                    <strong>Thanh toán khi nhận hàng (COD)</strong>
                                    <span>Trả tiền mặt khi giao hàng đến tay</span>
                                </div>
                            </label>
                        </div>

                        <div>
                            <input type="radio" name="PaymentMethod" value="VNPay"
                                   id="pay-vnpay" class="payment-option" />
                            <label for="pay-vnpay" class="payment-label">
                                <span class="payment-icon">💳</span>
                                <div class="payment-info">
                                    <strong>VNPay</strong>
                                    <span>Thẻ ATM nội địa, Visa/Master, QR Code, Ví điện tử</span>
                                </div>
                                <span class="vnpay-badge">VNPay</span>
                            </label>
                        </div>

                    </div>

                    <div style="margin-bottom:1rem;">
                        <label style="display:block;font-size:.875rem;font-weight:500;margin-bottom:.35rem;">Mã giảm giá</label>
                        <div style="display:flex;gap:.5rem;">
                            <input type="text" id="discount-input" class="form-control" value="@sessionDiscountCode"
                                   placeholder="Nhập mã khuyến mãi" style="text-transform:uppercase;" />
                            <button type="button" id="apply-discount-btn" class="btn btn-ghost btn-sm" style="white-space:nowrap;">Áp dụng</button>
                        </div>
                        <div id="discount-msg" style="margin-top:.35rem;font-size:.8rem;">
                            @if (!string.IsNullOrEmpty(sessionDiscountCode))
                            {
                                <span style="color:#16a34a;">✓ Đã áp dụng mã @sessionDiscountCode thành công</span>
                            }
                        </div>
                    </div>

                    <div id="vnpay-note" style="display:none; background:#fffbeb; border:1px solid #fde68a;
                        border-radius:10px; padding:.85rem 1rem; font-size:.85rem; margin-bottom:1rem;">
                        ⚡ Bạn sẽ được chuyển hướng đến trang thanh toán <strong>VNPay</strong> an toàn.
                        Sau khi thanh toán xong, hệ thống tự động xác nhận đơn hàng.
                    </div>

                    <button type="submit" id="submit-btn" class="btn btn-primary" style="width:100%; margin-top:.25rem;">
                        Đặt hàng &amp; Thanh toán COD
                    </button>
                </form>

                <script>
                                (function () {
                                    var codRadio   = document.getElementById('pay-cod');
                                    var vnpRadio   = document.getElementById('pay-vnpay');
                                    var note       = document.getElementById('vnpay-note');
                                    var submitBtn  = document.getElementById('submit-btn');

                                    function updateUI() {
                                        if (vnpRadio.checked) {
                                            note.style.display = 'block';
                                            submitBtn.textContent = '💳 Chuyển đến VNPay để thanh toán';
                                        } else {
                                            note.style.display = 'none';
                                            submitBtn.textContent = 'Đặt hàng & Thanh toán COD';
                                        }
                                    }
                                    codRadio.addEventListener('change', updateUI);
                                    vnpRadio.addEventListener('change', updateUI);

                                    // Đồng bộ biến tính tiền trong Javascript từ dữ liệu của Model
                                    var subtotal = @Model.Cart.Subtotal;
                                    var originalShipping = @((decimal?)ViewBag.OriginalShippingFee ?? Model.ShippingFee);
                                    var shipping = @Model.ShippingFee;
                                    var appliedDiscount = @serverDiscountAmount;

                                    function formatVND(n) {
                                        return new Intl.NumberFormat('vi-VN').format(n) + ' ₫';
                                    }

                                    document.getElementById('apply-discount-btn').addEventListener('click', function () {
                                        var code = document.getElementById('discount-input').value.trim();
                                        if (!code) return;

                                        fetch('/Checkout/ApplyDiscount', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ code: code })
                                        })
                                        .then(function(r) { return r.json(); })
                                        .then(function(data) {
                                            var msg = document.getElementById('discount-msg');
                                            if (data.success) {
                                                appliedDiscount = data.discountAmount;
                                                if (data.isFreeShipping) {
                                                    shipping = 0;
                                                } else {
                                                    shipping = originalShipping;
                                                }
                                                msg.style.color = '#16a34a';
                                                msg.textContent = '✓ ' + data.message;
                                                
                                                if (appliedDiscount > 0) {
                                                    document.getElementById('discount-row').style.display = 'flex';
                                                    document.getElementById('discount-value').textContent = '-' + formatVND(appliedDiscount);
                                                } else {
                                                    document.getElementById('discount-row').style.display = 'none';
                                                }
                                                
                                                document.getElementById('shipping-fee-display').textContent = formatVND(shipping);
                                                document.getElementById('total-price').textContent = formatVND(subtotal - appliedDiscount + shipping);
                                            } else {
                                                appliedDiscount = 0;
                                                shipping = originalShipping;
                                                msg.style.color = '#ef4444';
                                                msg.textContent = '✗ ' + data.message;
                                                document.getElementById('discount-row').style.display = 'none';
                                                document.getElementById('shipping-fee-display').textContent = formatVND(shipping);
                                                document.getElementById('total-price').textContent = formatVND(subtotal + shipping);
                                            }
                                        });
                                    });
                                })();
                </script>
            }
        </div>

        <div style="display:flex; flex-direction:column; gap:1rem;">
            <div class="glass-panel" style="padding:1.25rem;">
                <h3 style="margin:0 0 1rem; font-size:1rem; font-weight:700;">Tóm tắt đơn hàng</h3>

                @foreach (var item in Model.Cart.Items)
                {
                    <div class="summary-product">
                        <span style="color:var(--text); max-width:65%;">@item.Name <span style="color:var(--text-muted);">× @item.Quantity</span></span>
                        <span style="font-weight:600;">@item.LineTotal.ToString("N0") ₫</span>
                    </div>
                }

                <div style="margin-top:.75rem;">
                    <div class="summary-item">
                        <span>Tạm tính</span>
                        <span>@Model.Cart.Subtotal.ToString("N0") ₫</span>
                    </div>

                    <div class="summary-item" id="discount-row" style="display: @(serverDiscountAmount > 0 ? "flex" : "none"); color:#16a34a;">
                        <span>Giảm giá</span>
                        <span id="discount-value">-@serverDiscountAmount.ToString("N0") ₫</span>
                    </div>

                    <div class="summary-item">
                        <span>Phí vận chuyển</span>
                        <span id="shipping-fee-display">@Model.ShippingFee.ToString("N0") ₫</span>
                    </div>
                    <div class="summary-item total">
                        <span>Tổng cộng</span>
                        <span class="price" id="total-price">@((Model.Cart.Subtotal - serverDiscountAmount + Model.ShippingFee).ToString("N0")) ₫</span>
                    </div>
                </div>
            </div>

            <!-- Chọn Voucher giảm giá box -->
            <div class="glass-panel" style="padding:1.25rem;">
                <h3 style="margin:0 0 1rem; font-size:1rem; font-weight:700; display:flex; align-items:center; gap:0.35rem;">
                    <span>🎫</span> Chọn Voucher của bạn
                </h3>
                
                @{
                    var userVouchers = ViewBag.UserVouchers as List<WebApplication1.Models.Discount> ?? new();
                }

                @if (!userVouchers.Any())
                {
                    <p style="font-size:0.85rem; color:var(--text-muted); margin:0; text-align:center;">Bạn không có voucher khả dụng nào.</p>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:0.75rem; max-height:220px; overflow-y:auto; padding-right:0.25rem;">
                        @foreach (var v in userVouchers)
                        {
                            var isApplied = sessionDiscountCode == v.Code;
                            var leftVal = v.DiscountType == DiscountType.Percent ? $"{v.Value:N0}%" : $"{v.Value / 1000:N0}K";
                            var desc = v.PromotionType == PromotionType.FreeShipping ? "Miễn phí vận chuyển" : $"Giảm {v.Value:N0}₫ cho đơn từ {v.MinOrderAmount:N0}₫";
                            var ticketColor = v.PromotionType == PromotionType.FreeShipping ? "#10b981" : (v.PromotionType == PromotionType.FirstOrder ? "#f59e0b" : "#8b5cf6");
                            var ticketBg = v.PromotionType == PromotionType.FreeShipping ? "#f0fdf4" : (v.PromotionType == PromotionType.FirstOrder ? "#fffbeb" : "#f5f3ff");

                            <div class="checkout-voucher-card" 
                                 style="display:flex; align-items:center; border:1.5px solid @(isApplied ? ticketColor : "var(--border)"); 
                                        border-radius:10px; background:@ticketBg; padding:0.6rem; cursor:pointer; transition:all 0.15s;
                                        position:relative; overflow:hidden;"
                                 onclick="selectVoucherCode('@v.Code')">
                                 
                                 <div style="width:4px; height:100%; background:@ticketColor; position:absolute; left:0; top:0; bottom:0;"></div>
                                 
                                 <div style="flex:1; padding-left:0.5rem; display:flex; flex-direction:column; gap:0.15rem;">
                                     <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                                         <strong style="font-size:0.85rem; color:@ticketColor;">@v.Code</strong>
                                         @if (isApplied)
                                         {
                                             <span style="font-size:0.7rem; color:#fff; background:@ticketColor; padding:1px 5px; border-radius:4px; font-weight:600;">Đang dùng</span>
                                         }
                                     </div>
                                     <span style="font-size:0.75rem; color:var(--text-muted);">@desc</span>
                                 </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <script>
        function selectVoucherCode(code) {
            var currentCode = '@sessionDiscountCode';
            var targetCode = (currentCode === code) ? '' : code;

            var input = document.getElementById('discount-input');
            var btn = document.getElementById('apply-discount-btn');
            if (input && btn) {
                input.value = targetCode;
                btn.click();
            } else {
                fetch('/Checkout/ApplyDiscount', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: targetCode })
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                });
            }
        }
        </script>

    </div>
</div>