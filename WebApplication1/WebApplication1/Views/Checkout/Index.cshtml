@model WebApplication1.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<h1>Thanh toán — Bước @Model.Step / 2</h1>

<div class="detail-layout">
    <div class="glass-panel" style="padding:1.25rem;">
        @if (Model.Step == 1)
        {
            <h2>Thông tin giao hàng</h2>
            <form asp-action="Shipping" method="post">
                <div asp-validation-summary="All"></div>
                <div style="margin-bottom:0.75rem;">
                    <label asp-for="Shipping.FullName"></label>
                    <input asp-for="Shipping.FullName" class="form-control" />
                </div>
                <div style="margin-bottom:0.75rem;">
                    <label asp-for="Shipping.Phone"></label>
                    <input asp-for="Shipping.Phone" class="form-control" />
                </div>
                <div style="margin-bottom:0.75rem;">
                    <label asp-for="Shipping.ShippingAddress"></label>
                    <textarea asp-for="Shipping.ShippingAddress" class="form-control" rows="3"></textarea>
                </div>
                <div style="margin-bottom:0.75rem;">
                    <label asp-for="Shipping.Notes"></label>
                    <input asp-for="Shipping.Notes" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Tiếp tục thanh toán</button>
            </form>
        }
        else
        {
            <h2>Phương thức thanh toán</h2>
            <form asp-action="PlaceOrder" method="post">
                <div asp-validation-summary="All"></div>
                <div style="margin-bottom:0.75rem;">
                    <label>
                        <input type="radio" name="PaymentMethod" value="COD" checked /> Thanh toán khi nhận hàng (COD)
                    </label>
                </div>
                <div style="margin-bottom:0.75rem;">
                    <label>
                        <input type="radio" name="PaymentMethod" value="Card" /> Thẻ tín dụng (mô phỏng)
                    </label>
                </div>
                <div style="margin-bottom:0.75rem;">
                    <label>Số thẻ (mô phỏng)</label>
                    <input name="CardNumber" class="form-control" placeholder="4111 1111 1111 1111" />
                </div>
                <div style="margin-bottom:0.75rem;">
                    <label>Tên chủ thẻ</label>
                    <input name="CardName" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Đặt hàng</button>
            </form>
        }
    </div>
    <div class="glass-panel" style="padding:1.25rem;">
        <h3>Tóm tắt đơn hàng</h3>
        @foreach (var item in Model.Cart.Items)
        {
            <p>@item.Name × @item.Quantity — @item.LineTotal.ToString("N0") ₫</p>
        }
        <hr />
        <p>Tạm tính: @Model.Cart.Subtotal.ToString("N0") ₫</p>
        <p>Phí vận chuyển: 50.000 ₫</p>
        <p class="price">Tổng cộng: @((Model.Cart.Subtotal + 50000).ToString("N0")) ₫</p>
    </div>
</div>
