@model WebApplication1.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Phương thức thanh toán";

    // Lấy thông tin mã giảm giá và số tiền từ Session hoặc TempData do Controller đẩy sang (nếu có)
    var sessionDiscountCode = Context.Session.GetString("AppliedCouponCode") ?? "";
    var sessionDiscountAmountStr = Context.Session.GetString("DiscountAmount") ?? "0";
    decimal serverDiscountAmount = 0;
    decimal.TryParse(sessionDiscountAmountStr, out serverDiscountAmount);
}

<style>
    .checkout-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 1.5rem;
        align-items: start;
    }

    .checkout-step-bar {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 1.75rem;
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
    }

        .step-item.active {
            color: var(--accent);
        }

        .step-item.done {
            color: #16a34a;
        }

    .step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
        background: #f3f4f6;
        color: var(--text-muted);
        border: 2px solid #e5e7eb;
    }

    .step-item.active .step-num {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }

    .step-item.done .step-num {
        background: #16a34a;
        color: #fff;
        border-color: #16a34a;
    }

    .step-divider {
        flex: 1;
        height: 2px;
        background: #e5e7eb;
        margin: 0 12px;
        max-width: 60px;
    }

        .step-divider.done {
            background: #16a34a;
        }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.35rem;
            color: var(--text);
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.9rem;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: 0.9rem;
        font-family: inherit;
        outline: none;
        transition: border-color .15s;
        background: #fff;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: var(--accent);
        }

    /* ── Payment options ── */
    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .payment-option {
        display: none;
    }

    .payment-label {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 1rem 1.25rem;
        border: 2px solid var(--border);
        border-radius: 12px;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }

    .payment-option:checked + .payment-label {
        border-color: var(--accent);
        background: var(--accent-light);
    }

    .payment-icon {
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .payment-info strong {
        display: block;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .payment-info span {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .vnpay-badge {
        margin-left: auto;
        background: #1e3a8a;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        letter-spacing: 0.3px;
    }

    /* ── Order summary ── */
    .summary-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.875rem;
        padding: 0.35rem 0;
    }

        .summary-item.total {
            font-weight: 700;
            font-size: 1rem;
            border-top: 1px solid var(--border);
            margin-top: 0.5rem;
            padding-top: 0.75rem;
        }

            .summary-item.total .price {
                color: var(--accent);
            }

    .summary-product {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-size: 0.875rem;
    }

        .summary-product + .summary-product {
            border-top: 1px dashed #f3f4f6;
        }

    @@media (max-width: 720px) {
        .checkout-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div style="padding-top:1.5rem; padding-bottom:3rem;">

    <div class="checkout-step-bar">
        <div class="step-item done">
            <div class="step-num">✓</div>
            <span>Giao hàng</span>
        </div>
        <div class="step-divider done"></div>
        <div class="step-item active">
            <div class="step-num">2</div>
            <span>Thanh toán</span>
        </div>
    </div>

    <div class="checkout-layout">

        <div class="glass-panel" style="padding:1.5rem;">
            <h2 style="margin:0 0 1.25rem; font-size:1.2rem;">Phương thức thanh toán</h2>
            <form asp-action="PlaceOrder" method="post" id="payment-form">
                @Html.AntiForgeryToken()

                <div class="payment-options">

                    <div>
                        <input type="radio" name="PaymentMethod" value="COD"
                               id="pay-cod" class="payment-option" checked />
                        <label for="pay-cod" class="payment-label">
                            <span class="payment-icon">🚚</span>
                            <div class="payment-info">
                                <strong>Thanh toán khi nhận hàng (COD)</strong>
                                <span>Trả tiền mặt khi giao hàng đến tay</span>
                            </div>
                        </label>
                    </div>

                    <div>
                        <input type="radio" name="PaymentMethod" value="BankingAdmin"
                               id="pay-banking" class="payment-option" />
                        <label for="pay-banking" class="payment-label">
                            <span class="payment-icon">💳</span>
                            <div class="payment-info">
                                <strong>Thanh toán qua Banking Admin</strong>
                                <span>Chuyển khoản trực tiếp tới tài khoản Admin</span>
                            </div>
                            <span class="vnpay-badge">Banking QR</span>
                        </label>
                    </div>

                </div>

                <!-- Admin Banking Section -->
                <div id="banking-admin-section" style="display:none; background:#fff; border:1.5px solid var(--border);
                    border-radius:12px; padding:1.25rem; margin-bottom:1.25rem; box-shadow: var(--shadow-sm);">
                    <h4 style="margin:0 0 0.75rem; font-size:0.95rem; font-weight:700; color:var(--text);">🏦 Tài khoản Ngân hàng Admin</h4>
                    
                    <div style="display:grid; grid-template-columns: 1fr; gap:0.75rem; margin-bottom:1rem; font-size:0.875rem;">
                        <div style="display:flex; justify-content:space-between; border-bottom:1px dashed var(--border); padding-bottom:0.35rem;">
                            <span style="color:var(--text-muted);">Ngân hàng:</span>
                            <strong style="color:var(--text);">MB Bank (Ngân hàng Quân Đội)</strong>
                        </div>
                        <div style="display:flex; justify-content:space-between; border-bottom:1px dashed var(--border); padding-bottom:0.35rem;">
                            <span style="color:var(--text-muted);">Số tài khoản:</span>
                            <strong style="color:var(--text);">123456789</strong>
                        </div>
                        <div style="display:flex; justify-content:space-between; border-bottom:1px dashed var(--border); padding-bottom:0.35rem;">
                            <span style="color:var(--text-muted);">Chủ tài khoản:</span>
                            <strong style="color:var(--text);">VU VAN TRUNG</strong>
                        </div>
                    </div>

                    <!-- QR Code Mock -->
                    <div style="background:#f9fafb; padding:1rem; border-radius:10px; text-align:center; border:1px dashed var(--border); margin-bottom:1rem;">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=VU%20VAN%20TRUNG%20MBBANK%20123456789" 
                             alt="QR Banking Admin" 
                             style="width:160px; height:160px; margin:0 auto 0.5rem; display:block; border-radius:8px; border:1px solid #e5e7eb;" />
                        <span style="font-size:0.75rem; color:var(--text-muted); display:block;">Quét mã QR để chuyển khoản trực tiếp</span>
                    </div>

                    <!-- Maintenance Alert -->
                    <div style="background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:0.65rem 0.85rem; font-size:0.8rem; color:#b45309; display:flex; align-items:start; gap:0.5rem;">
                        <span>🔧</span>
                        <div>
                            <strong>Chế độ Bảo trì:</strong> Hệ thống tự động xác nhận giao dịch qua QR đang bảo trì. Quý khách vui lòng nhập mã nhân viên <strong>`DEMOSTAFF`</strong> tại ô Mã giảm giá để giả lập thanh toán thành công tự động.
                        </div>
                    </div>
                </div>

                <div style="margin-bottom:1rem;">
                    <label style="display:block;font-size:.875rem;font-weight:500;margin-bottom:.35rem;">Mã giảm giá / Mã nhân viên</label>
                    <div style="display:flex;gap:.5rem;">
                        <input type="text" id="discount-input" class="form-control" value="@sessionDiscountCode"
                               placeholder="Nhập mã khuyến mãi hoặc mã DEMOSTAFF" style="text-transform:uppercase;" />
                        <button type="button" id="apply-discount-btn" class="btn btn-ghost btn-sm" style="white-space:nowrap;">Áp dụng</button>
                    </div>
                    <div id="discount-msg" style="margin-top:.35rem;font-size:.8rem;">
                        @if (!string.IsNullOrEmpty(sessionDiscountCode))
                        {
                            var isStaff = sessionDiscountCode == "DEMOSTAFF";
                            var color = isStaff ? "#8b5cf6" : "#16a34a";
                            var msg = isStaff ? "✓ Đã áp dụng mã Nhân viên DEMOSTAFF (Miễn phí 100% đơn hàng & thanh toán tự động)" : $"✓ Đã áp dụng mã {sessionDiscountCode} thành công";
                            <span style="color:@color;">@msg</span>
                        }
                    </div>
                </div>

                <button type="submit" id="submit-btn" class="btn btn-primary" style="width:100%; margin-top:.25rem;">
                    Đặt hàng &amp; Thanh toán COD
                </button>
            </form>

            <script>
                (function () {
                    var codRadio       = document.getElementById('pay-cod');
                    var bankingRadio   = document.getElementById('pay-banking');
                    var bankingSection = document.getElementById('banking-admin-section');
                    var submitBtn      = document.getElementById('submit-btn');

                    function updateUI() {
                        if (bankingRadio.checked) {
                            bankingSection.style.display = 'block';
                            submitBtn.textContent = 'Đặt hàng & Xác nhận Banking Admin';
                        } else {
                            bankingSection.style.display = 'none';
                            submitBtn.textContent = 'Đặt hàng & Thanh toán COD';
                        }
                    }
                    codRadio.addEventListener('change', updateUI);
                    bankingRadio.addEventListener('change', updateUI);

                    // Khởi chạy đồng bộ UI lúc tải trang
                    updateUI();

                    // Đồng bộ biến tính tiền trong Javascript từ dữ liệu của Model
                    var subtotal = @Model.Cart.Subtotal;
                    var originalShipping = @((decimal?)ViewBag.OriginalShippingFee ?? Model.ShippingFee);
                    var shipping = @Model.ShippingFee;
                    var appliedDiscount = @serverDiscountAmount;

                    function formatVND(n) {
                        return new Intl.NumberFormat('vi-VN').format(n) + ' ₫';
                    }

                    document.getElementById('apply-discount-btn').addEventListener('click', function () {
                        var code = document.getElementById('discount-input').value.trim();
                        if (!code) return;

                        fetch('/Checkout/ApplyDiscount', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ code: code })
                        })
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            var msg = document.getElementById('discount-msg');
                            if (data.success) {
                                appliedDiscount = data.discountAmount;
                                if (data.isFreeShipping) {
                                    shipping = 0;
                                } else {
                                    shipping = originalShipping;
                                }
                                
                                if (data.code === 'DEMOSTAFF') {
                                    msg.style.color = '#8b5cf6';
                                    msg.textContent = '✓ Đã áp dụng mã Nhân viên DEMOSTAFF (Miễn phí 100% đơn hàng & thanh toán tự động)';
                                    shipping = 0;
                                } else {
                                    msg.style.color = '#16a34a';
                                    msg.textContent = '✓ ' + data.message;
                                }
                                
                                if (appliedDiscount > 0) {
                                    document.getElementById('discount-row').style.display = 'flex';
                                    document.getElementById('discount-value').textContent = '-' + formatVND(appliedDiscount);
                                } else {
                                    document.getElementById('discount-row').style.display = 'none';
                                }
                                
                                document.getElementById('shipping-fee-display').textContent = formatVND(shipping);
                                document.getElementById('total-price').textContent = formatVND(subtotal - appliedDiscount + shipping);
                                
                                // Tải lại trang sau 1.5 giây để cập nhật đồng bộ các Voucher khả dụng bên phải
                                setTimeout(function() {
                                    location.reload();
                                }, 1500);
                            } else {
                                appliedDiscount = 0;
                                shipping = originalShipping;
                                msg.style.color = '#ef4444';
                                msg.textContent = '✗ ' + data.message;
                                document.getElementById('discount-row').style.display = 'none';
                                document.getElementById('shipping-fee-display').textContent = formatVND(shipping);
                                document.getElementById('total-price').textContent = formatVND(subtotal + shipping);
                            }
                        });
                    });
                })();
            </script>
        </div>

        <div style="display:flex; flex-direction:column; gap:1rem;">
            <div class="glass-panel" style="padding:1.25rem;">
                <h3 style="margin:0 0 1rem; font-size:1rem; font-weight:700;">Tóm tắt đơn hàng</h3>

                @foreach (var item in Model.Cart.Items)
                {
                    <div class="summary-product">
                        <span style="color:var(--text); max-width:65%;">@item.Name <span style="color:var(--text-muted);">× @item.Quantity</span></span>
                        <span style="font-weight:600;">@item.LineTotal.ToString("N0") ₫</span>
                    </div>
                }

                <div style="margin-top:.75rem;">
                    <div class="summary-item">
                        <span>Tạm tính</span>
                        <span>@Model.Cart.Subtotal.ToString("N0") ₫</span>
                    </div>

                    <div class="summary-item" id="discount-row" style="display: @(serverDiscountAmount > 0 ? "flex" : "none"); color:#16a34a;">
                        <span>Giảm giá</span>
                        <span id="discount-value">-@serverDiscountAmount.ToString("N0") ₫</span>
                    </div>

                    <div class="summary-item">
                        <span>Phí vận chuyển</span>
                        <span id="shipping-fee-display">@Model.ShippingFee.ToString("N0") ₫</span>
                    </div>
                    <div class="summary-item total">
                        <span>Tổng cộng</span>
                        <span class="price" id="total-price">@((Model.Cart.Subtotal - serverDiscountAmount + Model.ShippingFee).ToString("N0")) ₫</span>
                    </div>
                </div>
            </div>

            <!-- Chọn Voucher giảm giá box -->
            <div class="glass-panel" style="padding:1.25rem;">
                <h3 style="margin:0 0 1rem; font-size:1rem; font-weight:700; display:flex; align-items:center; gap:0.35rem;">
                    <span>🎫</span> Chọn Voucher của bạn
                </h3>
                
                @{
                    var userVouchers = ViewBag.UserVouchers as List<WebApplication1.Models.Discount> ?? new();
                }

                @if (!userVouchers.Any())
                {
                    <p style="font-size:0.85rem; color:var(--text-muted); margin:0; text-align:center;">Bạn không có voucher khả dụng nào.</p>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:0.75rem; max-height:220px; overflow-y:auto; padding-right:0.25rem;">
                        @foreach (var v in userVouchers)
                        {
                            var isApplied = sessionDiscountCode == v.Code;
                            var leftVal = v.DiscountType == DiscountType.Percent ? $"{v.Value:N0}%" : $"{v.Value / 1000:N0}K";
                            var desc = v.PromotionType == PromotionType.FreeShipping ? "Miễn phí vận chuyển" : $"Giảm {v.Value:N0}₫ cho đơn từ {v.MinOrderAmount:N0}₫";
                            var ticketColor = v.PromotionType == PromotionType.FreeShipping ? "#10b981" : (v.PromotionType == PromotionType.FirstOrder ? "#f59e0b" : "#8b5cf6");
                            var ticketBg = v.PromotionType == PromotionType.FreeShipping ? "#f0fdf4" : (v.PromotionType == PromotionType.FirstOrder ? "#fffbeb" : "#f5f3ff");

                            <div class="checkout-voucher-card" 
                                 style="display:flex; align-items:center; border:1.5px solid @(isApplied ? ticketColor : "var(--border)"); 
                                        border-radius:10px; background:@ticketBg; padding:0.6rem; cursor:pointer; transition:all 0.15s;
                                        position:relative; overflow:hidden;"
                                 onclick="selectVoucherCode('@v.Code')">
                                 
                                 <div style="width:4px; height:100%; background:@ticketColor; position:absolute; left:0; top:0; bottom:0;"></div>
                                 
                                 <div style="flex:1; padding-left:0.5rem; display:flex; flex-direction:column; gap:0.15rem;">
                                     <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                                         <strong style="font-size:0.85rem; color:@ticketColor;">@v.Code</strong>
                                         @if (isApplied)
                                         {
                                             <span style="font-size:0.7rem; color:#fff; background:@ticketColor; padding:1px 5px; border-radius:4px; font-weight:600;">Đang dùng</span>
                                         }
                                     </div>
                                     <span style="font-size:0.75rem; color:var(--text-muted);">@desc</span>
                                 </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <script>
        function selectVoucherCode(code) {
            var currentCode = '@sessionDiscountCode';
            var targetCode = (currentCode === code) ? '' : code;

            var input = document.getElementById('discount-input');
            var btn = document.getElementById('apply-discount-btn');
            if (input && btn) {
                input.value = targetCode;
                btn.click();
            }
        }
        </script>

    </div>
</div>
