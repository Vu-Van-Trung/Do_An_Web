@using System.Security.Claims
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string c, string a = "Index") =>
        (ctrl == c && action == a) ? "nav-active" : string.Empty;
}
<!DOCTYPE html>
<html lang="vi" style="scroll-behavior:smooth;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexusGear</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gaming-theme.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav container">
            <a class="brand" asp-controller="Home" asp-action="Index">Nexus<span>Gear</span></a>
            <button class="nav-toggle" id="nav-toggle" aria-label="Mở menu" aria-expanded="false">&#9776;</button>
            <div class="nav-links" id="nav-links">
                <a asp-controller="Home" asp-action="Index" class="@NavClass("Home")">Trang chủ</a>
                <a asp-controller="Product" asp-action="Index" class="@NavClass("Product")">Cửa hàng</a>
                <a asp-controller="Category" asp-action="Index" class="@NavClass("Category")">Danh mục</a>
                <a asp-controller="Product" asp-action="Deals" class="@NavClass("Product", "Deals")">Khuyến mãi</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Account" asp-action="Orders" class="@NavClass("Account", "Orders")">Tài khoản</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">Quản trị</a>
                    }
                    <a asp-controller="Cart" asp-action="Index" class="@NavClass("Cart")">
                        &#x1F6D2; Giỏ hàng <span id="cart-badge" class="badge">0</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Cart" asp-action="Index" class="@NavClass("Cart")">
                        &#x1F6D2; Giỏ hàng <span id="cart-badge" class="badge">0</span>
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="@NavClass("Account", "Login")">Tài khoản</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Đăng ký</a>
                }
            </div>
        </nav>
    </header>

    <main class="container main-content">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>&copy; @DateTime.Now.Year NexusGear — Thiết Bị Gaming Cao Cấp</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
</body>
</html>
