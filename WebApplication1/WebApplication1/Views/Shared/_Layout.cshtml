@using System.Security.Claims
@{
    var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string c, string a = "Index") =>
        (ctrl == c && action == a) ? "nav-active" : string.Empty;
    var userName    = User.Identity?.Name ?? "";
    var displayName = userName.Contains("@") ? userName.Split("@")[0] : userName;
}
<!DOCTYPE html>
<html lang="vi" data-theme="light" style="scroll-behavior:smooth;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexusGear</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/bootstrap/css-20260516T012313Z-3-001/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gaming-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header class="site-header">
        <nav class="nav container">
            <a class="brand" asp-controller="Home" asp-action="Index">Nexus<span>Gear</span></a>

            <button class="nav-toggle" id="nav-toggle" aria-label="Mở menu" aria-expanded="false">&#9776;</button>

            <div class="nav-links" id="nav-links">
                @* Main navigation links *@
                <div class="nav-main-links">
                    <a asp-controller="Home"     asp-action="Index"  class="@NavClass("Home")">Trang chủ</a>
                    <a asp-controller="Product"  asp-action="Index"  class="@NavClass("Product")">Cửa hàng</a>
                    <a asp-controller="Category" asp-action="Index"  class="@NavClass("Category")">Danh mục</a>
                    <a asp-controller="Product"  asp-action="Deals"  class="nav-deals @NavClass("Product", "Deals")">🎫 Voucher</a>
                </div>

                @* Action area (cart + auth) *@
                <div class="nav-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="theme-toggle" id="themeToggle" title="Chuyển chế độ sáng/tối">
                            <i class="bi bi-moon-fill"></i>
                        </button>
                        @* So sánh *@
                        <a asp-controller="Comparison" asp-action="Index" class="nav-cart-btn @NavClass("Comparison")" title="So sánh sản phẩm">
                            <i class="bi bi-arrow-left-right"></i> So sánh sản phẩm
                        </a>
                        @* Giỏ hàng *@
                        <a asp-controller="Cart" asp-action="Index" class="nav-cart-btn @NavClass("Cart")" title="Giỏ hàng">
                            &#x1F6D2; Giỏ hàng <span id="cart-badge" class="badge">0</span>
                        </a>

                        @* User dropdown khi đã đăng nhập *@
                        <div class="user-dropdown" id="userDropdown">
                            <button class="user-dropdown-trigger" id="userDropdownBtn" aria-expanded="false">
                                <span class="user-avatar">@(displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U")</span>
                                <span class="user-name-text">@displayName</span>
                                <span class="dropdown-arrow">&#9660;</span>
                            </button>
                            <div class="user-dropdown-menu" id="userDropdownMenu">
                                <a asp-controller="Account" asp-action="Profile" class="dropdown-item">
                                    👤 Hồ sơ cá nhân
                                </a>
                                <a asp-controller="Account" asp-action="Orders" class="dropdown-item">
                                    📦 Đơn hàng của tôi
                                </a>
                                <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item">
                                    🔑 Đổi mật khẩu
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="dropdown-divider"></div>
                                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="dropdown-item dropdown-item-admin">
                                        ⚙️ Quản trị
                                    </a>
                                }
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item dropdown-item-danger">
                                        🚪 Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="theme-toggle" id="themeToggle" title="Chuyển chế độ sáng/tối">
                            <i class="bi bi-moon-fill"></i>
                        </button>
                        @* So sánh *@
                        <a asp-controller="Comparison" asp-action="Index" class="nav-cart-btn @NavClass("Comparison")" title="So sánh sản phẩm">
                            <i class="bi bi-arrow-left-right"></i> So sánh sản phẩm
                        </a>
                        @* Giỏ hàng khi chưa login *@
                        <a asp-controller="Cart" asp-action="Index" class="nav-cart-btn @NavClass("Cart")" title="Giỏ hàng">
                            &#x1F6D2; Giỏ hàng <span id="cart-badge" class="badge">0</span>
                        </a>

                        @* Nút Đăng nhập riêng biệt *@
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-ghost btn-sm @NavClass("Account", "Login")"
                           id="nav-login-btn">Đăng nhập</a>

                        @* Nút Đăng ký riêng biệt *@
                        <a asp-controller="Account" asp-action="Register"
                           class="btn btn-primary btn-sm"
                           id="nav-register-btn">Đăng ký</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container main-content">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <a class="brand" asp-controller="Home" asp-action="Index" style="font-size:1.1rem;text-decoration:none;">Nexus<span>Gear</span></a>
                <p>Thiết bị gaming cao cấp — Uy tín &amp; Chất lượng</p>
                <div class="footer-contact-info" style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
                    <p style="margin: 0 0 0.25rem 0;">📍 Địa chỉ: 10/80c Song Hành Xa Lộ Hà Nội, Tăng Nhơn Phú, Thủ Đức, TP. Hồ Chí Minh</p>
                    <p style="margin: 0;">📞 Hotline: 1900 8198 | Email: support@nexusgear.vn</p>
                </div>
            </div>
            <div class="footer-links">
                <a asp-controller="Product"  asp-action="Index">Cửa hàng</a>
                <a asp-controller="Product"  asp-action="Deals">Voucher</a>
                <a asp-controller="Category" asp-action="Index">Danh mục</a>
            </div>
            <p class="footer-copy">&copy; @DateTime.Now.Year NexusGear. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/bootstrap/js-20260516T012316Z-3-001/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
</body>
</html>
