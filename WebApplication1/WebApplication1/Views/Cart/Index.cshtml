@model WebApplication1.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h1>Giỏ hàng</h1>

@if (!Model.Items.Any())
{
    <p class="meta">Giỏ hàng của bạn đang trống. <a asp-controller="Product" asp-action="Index">Xem sản phẩm</a></p>
}
else
{
    <div class="glass-panel" style="padding:1rem;">
        <div class="table-scroll">
        <table class="cart-table">
            <thead>
                <tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                        </td>
                        <td>@item.UnitPrice.ToString("N0") ₫</td>
                        <td>
                            <input type="number" min="1" max="@item.Stock" value="@item.Quantity"
                                   data-cart-qty data-cart-item-id="@item.CartItemId" class="form-control" style="width:80px;" />
                        </td>
                        <td>@item.LineTotal.ToString("N0") ₫</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <button type="submit" class="btn btn-ghost btn-sm">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <p style="text-align:right; font-size:1.2rem; margin-top:1rem;">
            Tổng cộng: <strong data-cart-subtotal>@Model.Subtotal.ToString("N0") ₫</strong>
        </p>
        <div class="cart-actions">
            <a asp-controller="Product" asp-action="Index" class="btn btn-ghost">Tiếp tục mua</a>
            <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary">Thanh toán</a>
        </div>
    </div>
}
