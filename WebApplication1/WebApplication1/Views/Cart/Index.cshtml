@model WebApplication1.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<h1>Shopping Cart</h1>

@if (!Model.Items.Any())
{
    <p class="meta">Your cart is empty. <a asp-controller="Product" asp-action="Index">Browse products</a></p>
}
else
{
    <div class="glass-panel" style="padding:1rem;">
        <table class="cart-table">
            <thead>
                <tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                        </td>
                        <td>@item.UnitPrice.ToString("N0") ₫</td>
                        <td>
                            <input type="number" min="1" max="@item.Stock" value="@item.Quantity"
                                   data-cart-qty data-cart-item-id="@item.CartItemId" class="form-control" style="width:80px;" />
                        </td>
                        <td>@item.LineTotal.ToString("N0") ₫</td>
                        <td>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p style="text-align:right; font-size:1.2rem;">
            Total: <strong data-cart-subtotal>@Model.Subtotal.ToString("N0") ₫</strong>
        </p>
        <div style="display:flex; gap:1rem; justify-content:flex-end; margin-top:1rem;">
            <a asp-controller="Product" asp-action="Index" class="btn btn-ghost">Continue Shopping</a>
            <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary">Checkout</a>
        </div>
    </div>
}
