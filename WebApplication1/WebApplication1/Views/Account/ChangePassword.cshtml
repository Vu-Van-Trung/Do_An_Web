@model WebApplication1.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="glass-panel" style="max-width:480px; margin:2rem auto; padding:2rem;">
    <h1 style="font-family:var(--font-display); font-size:1.6rem; font-weight:700; margin-top:0; margin-bottom:1.5rem;">🔑 Đổi mật khẩu</h1>

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem;"></div>

        <div style="margin-bottom:1.25rem;">
            <label asp-for="OldPassword" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Mật khẩu hiện tại *</label>
            <input asp-for="OldPassword" class="form-control" placeholder="••••••" required />
            <span asp-validation-for="OldPassword" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <div style="margin-bottom:1.25rem;">
            <label asp-for="NewPassword" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Mật khẩu mới *</label>
            <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
            <span asp-validation-for="NewPassword" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <div style="margin-bottom:1.5rem;">
            <label asp-for="ConfirmPassword" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Xác nhận mật khẩu mới *</label>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; padding:0.75rem;">Đổi mật khẩu</button>
    </form>
</div>
