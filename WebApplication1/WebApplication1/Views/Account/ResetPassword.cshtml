@model WebApplication1.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="glass-panel" style="max-width:460px; margin:2rem auto; padding:2rem;">
    <h1 style="font-family:var(--font-display); font-size:1.5rem; font-weight:700; margin-top:0; margin-bottom:1rem;">🔑 Đặt lại mật khẩu</h1>

    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem;"></div>

        <div style="margin-bottom:1.25rem;">
            <label style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Địa chỉ Email</label>
            <input asp-for="Email" class="form-control" style="background:rgba(255,255,255,0.02); opacity:0.65; cursor:not-allowed;" readonly disabled />
        </div>

        <div style="margin-bottom:1.25rem;">
            <label asp-for="Password" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Mật khẩu mới *</label>
            <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
            <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <div style="margin-bottom:1.5rem;">
            <label asp-for="ConfirmPassword" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Xác nhận mật khẩu mới *</label>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; padding:0.7rem;">Đặt lại mật khẩu</button>
    </form>
</div>
