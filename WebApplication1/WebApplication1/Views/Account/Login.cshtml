@model WebApplication1.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    .or-divider {
        display: flex; align-items: center; gap: .75rem;
        margin: 1.1rem 0; color: var(--text-muted); font-size: .8rem;
    }
    .or-divider::before, .or-divider::after {
        content: ''; flex: 1; height: 1px; background: var(--border);
    }
    .btn-google {
        width: 100%; display: flex; align-items: center; justify-content: center;
        gap: .65rem; padding: .65rem 1rem; border-radius: 10px;
        border: 1.5px solid var(--border); background: #fff;
        font-size: .9rem; font-weight: 600; color: #374151;
        cursor: pointer; transition: border-color .15s, box-shadow .15s;
        text-decoration: none;
    }
    .btn-google:hover { border-color: #4285f4; box-shadow: 0 2px 8px rgba(66,133,244,.2); color: #374151; }
    .btn-google svg { flex-shrink: 0; }
</style>

<div class="glass-panel" style="max-width:420px; margin:2rem auto; padding:1.5rem;">
    <h1 style="margin-bottom:1.25rem;">Đăng nhập</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert" style="background:#fff1f2; border:1px solid #fecdd3; border-radius:10px; padding:.75rem 1rem; margin-bottom:.75rem; color:#be123c; font-size:.875rem;">
            @TempData["Error"]
        </div>
    }

    <!-- Google OAuth -->
    <form asp-action="ExternalLogin" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="provider" value="Google" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="btn-google">
            <svg width="18" height="18" viewBox="0 0 18 18">
                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z"/>
            </svg>
            Tiếp tục với Google
        </button>
    </form>

    <div class="or-divider">hoặc</div>

    <!-- Email/password -->
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="All" class="text-danger" style="margin-bottom:.5rem;"></div>
        <div style="margin-bottom:0.75rem;">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
        </div>
        <div style="margin-bottom:0.75rem;">
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" class="form-control" placeholder="••••••" />
        </div>
        <label style="font-size:.875rem;"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label>
        <button type="submit" class="btn btn-primary" style="width:100%; margin-top:1rem;">Đăng nhập</button>
    </form>

    <p class="meta" style="margin-top:1rem; text-align:center; font-size:.875rem;">
        Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
    </p>
</div>
