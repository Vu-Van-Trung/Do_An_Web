@model WebApplication1.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="glass-panel" style="max-width:550px; margin:2rem auto; padding:2rem;">
    <h1 style="font-family:var(--font-display); font-size:1.6rem; font-weight:700; margin-top:0; margin-bottom:1.5rem;">👤 Thông tin tài khoản</h1>

    <form asp-action="Profile" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem;"></div>

        <div style="margin-bottom:1.25rem;">
            <label asp-for="Email" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Địa chỉ Email (Không thể thay đổi)</label>
            <input asp-for="Email" class="form-control" style="background:rgba(255,255,255,0.02); opacity:0.65; cursor:not-allowed;" readonly />
        </div>

        <div style="margin-bottom:1.25rem;">
            <label asp-for="FullName" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Họ và tên *</label>
            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
            <span asp-validation-for="FullName" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <div style="margin-bottom:1.25rem;">
            <label asp-for="PhoneNumber" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Số điện thoại</label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="09xx xxx xxx" />
            <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <div style="margin-bottom:1.5rem;">
            <label style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Địa chỉ mặc định</label>
            
            <div style="display:grid; grid-template-columns:1fr; gap:0.75rem; margin-bottom:0.75rem;">
                <div>
                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Tỉnh / Thành phố *</label>
                    <select id="provinceSelect" class="form-control" required>
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                </div>
                <div>
                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Phường / Xã *</label>
                    <select id="wardSelect" class="form-control" required disabled>
                        <option value="">-- Chọn Phường/Xã --</option>
                    </select>
                </div>
                <div>
                    <label style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.25rem;">Số nhà, tên đường (Địa chỉ cụ thể) *</label>
                    <input type="text" id="specificAddress" class="form-control" placeholder="Số nhà, tên đường..." required />
                </div>
            </div>
            
            <input type="hidden" asp-for="Address" id="combinedAddress" />
            <span asp-validation-for="Address" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; padding:0.75rem;">Lưu thay đổi</button>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const provinceSelect = document.getElementById("provinceSelect");
    const wardSelect = document.getElementById("wardSelect");
    const specificAddressInput = document.getElementById("specificAddress");
    const combinedAddressInput = document.getElementById("combinedAddress");
    const form = combinedAddressInput.closest("form");

    const initialAddressValue = combinedAddressInput.value.trim();

    fetch("https://provinces.open-api.vn/api/v2/p/")
        .then(res => res.json())
        .then(provinces => {
            provinces.forEach(p => {
                const opt = document.createElement("option");
                opt.value = p.code;
                opt.textContent = p.name;
                provinceSelect.appendChild(opt);
            });

            if (initialAddressValue) {
                parseAndSetAddress(initialAddressValue, provinces);
            }
        })
        .catch(err => console.error("Error loading provinces:", err));

    provinceSelect.addEventListener("change", function () {
        wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
        wardSelect.disabled = true;

        const pCode = this.value;
        if (!pCode) return;

        fetch(`https://provinces.open-api.vn/api/v2/p/${pCode}?depth=2`)
            .then(res => res.json())
            .then(data => {
                const wards = data.wards || [];
                wards.forEach(w => {
                    const opt = document.createElement("option");
                    opt.value = w.code;
                    opt.textContent = w.name;
                    wardSelect.appendChild(opt);
                });
                wardSelect.disabled = false;
            })
            .catch(err => console.error("Error loading wards:", err));
    });

    form.addEventListener("submit", function (e) {
        if (provinceSelect.value && wardSelect.value && specificAddressInput.value) {
            const provinceName = provinceSelect.options[provinceSelect.selectedIndex].text;
            const wardName = wardSelect.options[wardSelect.selectedIndex].text;
            const specific = specificAddressInput.value.trim();

            combinedAddressInput.value = `${specific}, ${wardName}, ${provinceName}`;
        }
    });

    function parseAndSetAddress(fullAddress, provinces) {
        const parts = fullAddress.split(",").map(p => p.trim());
        if (parts.length < 3) {
            specificAddressInput.value = fullAddress;
            return;
        }

        const provinceName = parts[parts.length - 1];
        const wardName = parts[parts.length - 2];
        const specificName = parts.slice(0, parts.length - 2).join(", ");

        const foundProvince = provinces.find(p =>
            p.name.toLowerCase() === provinceName.toLowerCase() ||
            p.name.toLowerCase().includes(provinceName.toLowerCase())
        );
        if (!foundProvince) {
            specificAddressInput.value = fullAddress;
            return;
        }

        provinceSelect.value = foundProvince.code;

        fetch(`https://provinces.open-api.vn/api/v2/p/${foundProvince.code}?depth=2`)
            .then(res => res.json())
            .then(data => {
                const wards = data.wards || [];
                wards.forEach(w => {
                    const opt = document.createElement("option");
                    opt.value = w.code;
                    opt.textContent = w.name;
                    wardSelect.appendChild(opt);
                });
                wardSelect.disabled = false;

                const foundWard = wards.find(w =>
                    w.name.toLowerCase() === wardName.toLowerCase() ||
                    w.name.toLowerCase().includes(wardName.toLowerCase())
                );
                if (foundWard) wardSelect.value = foundWard.code;
                specificAddressInput.value = specificName;
            })
            .catch(err => {
                console.error("Error auto-populating address:", err);
                specificAddressInput.value = fullAddress;
            });
    }
});
</script>
}
