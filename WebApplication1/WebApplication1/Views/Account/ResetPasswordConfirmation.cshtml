@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="glass-panel" style="max-width:480px; margin:2rem auto; padding:2rem; text-align:center;">
    <div style="font-size:3rem; margin-bottom:1rem;">🎉</div>
    <h1 style="font-family:var(--font-display); font-size:1.5rem; font-weight:700; margin-top:0; margin-bottom:0.75rem;">Đặt lại mật khẩu thành công!</h1>
    
    <p style="font-size:0.92rem; color:var(--text-muted); line-height:1.6; margin-bottom:1.5rem;">
        Mật khẩu của bạn đã được cập nhật thành công. Bạn hiện tại có thể dùng mật khẩu mới này để đăng nhập vào hệ thống.
    </p>

    <a asp-action="Login" class="btn btn-primary" style="width:100%; padding:0.75rem; text-decoration:none;">Đăng nhập ngay</a>
</div>
