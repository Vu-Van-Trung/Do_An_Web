@{
    ViewData["Title"] = "Xác nhận gửi khôi phục";
    var directLink = TempData["DirectResetLink"] as string;
}

<div class="glass-panel" style="max-width:550px; margin:2rem auto; padding:2rem; text-align:center;">
    <div style="font-size:3rem; margin-bottom:1rem;">📨</div>
    <h1 style="font-family:var(--font-display); font-size:1.5rem; font-weight:700; margin-top:0; margin-bottom:0.75rem;">Yêu cầu khôi phục đã được xử lý</h1>
    
    <p style="font-size:0.92rem; line-height:1.6; color:var(--text-muted); margin-bottom:1.5rem;">
        Nếu địa chỉ email bạn nhập tồn tại trong hệ thống, yêu cầu đặt lại mật khẩu đã được tạo.
    </p>

    @if (!string.IsNullOrEmpty(directLink))
    {
        <div style="background:rgba(139, 92, 246, 0.08); border:1.5px dashed var(--accent); border-radius:12px; padding:1.25rem; margin-bottom:1.5rem; text-align:left;">
            <strong style="color:var(--accent); display:block; margin-bottom:0.4rem; font-size:0.9rem;">🛠️ Local Development Link:</strong>
            <p style="font-size:0.85rem; line-height:1.5; margin:0 0 0.75rem; color:var(--text);">
                Do ứng dụng đang chạy ở môi trường phát triển (Local), chúng tôi đã tạo trực tiếp link đặt lại mật khẩu để bạn kiểm thử nhanh mà không cần máy chủ gửi mail:
            </p>
            <a href="@directLink" class="btn btn-primary btn-sm" style="display:inline-flex; text-decoration:none;">Đổi mật khẩu ngay</a>
            <div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.5rem; word-break:break-all;">
                URL: @directLink
            </div>
        </div>
    }

    <a asp-action="Login" class="btn btn-ghost" style="padding:0.6rem 1.25rem;">Quay lại Đăng nhập</a>
</div>
