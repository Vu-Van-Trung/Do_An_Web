@{
    ViewData["Title"] = "Xác nhận gửi khôi phục";
    var emailError = TempData["EmailError"] as string;
}

<div class="glass-panel" style="max-width:550px; margin:2rem auto; padding:2rem; text-align:center;">
    <div style="font-size:3rem; margin-bottom:1rem;">📨</div>
    <h1 style="font-family:var(--font-display); font-size:1.5rem; font-weight:700; margin-top:0; margin-bottom:0.75rem;">Yêu cầu khôi phục đã được xử lý</h1>
    
    <p style="font-size:0.92rem; line-height:1.6; color:var(--text-muted); margin-bottom:1.5rem;">
        Nếu địa chỉ email bạn nhập tồn tại trong hệ thống, yêu cầu đặt lại mật khẩu đã được tạo.
    </p>

    @if (!string.IsNullOrEmpty(emailError))
    {
        <div style="background:rgba(239, 68, 68, 0.08); border:1.5px dashed #f87171; border-radius:12px; padding:1rem; margin-bottom:1.5rem; text-align:left; font-size:0.85rem; color:#cbd5e1; line-height:1.5;">
            <strong style="color:#f87171; display:block; margin-bottom:0.25rem;">⚠️ Lỗi gửi Email:</strong>
            @emailError
        </div>
    }

    <a asp-action="Login" class="btn btn-ghost" style="padding:0.6rem 1.25rem;">Quay lại Đăng nhập</a>
</div>
