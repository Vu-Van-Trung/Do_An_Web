@model WebApplication1.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="glass-panel" style="max-width:440px; margin:2rem auto; padding:2rem;">
    <h1 style="font-family:var(--font-display); font-size:1.5rem; font-weight:700; margin-top:0; margin-bottom:0.5rem;">🔑 Khôi phục mật khẩu</h1>
    <p class="meta" style="margin-bottom:1.5rem;">Nhập email liên kết với tài khoản của bạn để khôi phục.</p>

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div style="margin-bottom:1.5rem;">
            <label asp-for="Email" style="display:block; font-size:0.82rem; font-weight:600; color:var(--text-muted); margin-bottom:0.35rem;">Địa chỉ Email</label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" required />
            <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem; margin-top:0.25rem; display:block;"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; padding:0.7rem;">Gửi yêu cầu</button>
    </form>
    
    <p class="meta" style="margin-top:1.25rem; text-align:center; font-size:0.85rem; margin-bottom:0;">
        <a asp-action="Login" style="text-decoration:none;"> Quay lại đăng nhập</a>
    </p>
</div>
