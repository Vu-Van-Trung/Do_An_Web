@model IEnumerable<WebApplication1.Models.Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<h1>Lịch sử đơn hàng</h1>

@if (!Model.Any())
{
    <p class="meta">Bạn chưa có đơn hàng nào.</p>
}
else
{
    <div class="glass-panel" style="padding:1rem;">
        <table class="cart-table">
            <thead>
                <tr><th>Mã đơn</th><th>Ngày đặt</th><th>Trạng thái</th><th>Tổng tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                        <td>@order.Status</td>
                        <td>@order.Total.ToString("N0") ₫</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
